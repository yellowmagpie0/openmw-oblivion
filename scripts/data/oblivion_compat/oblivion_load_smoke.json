{
  "schema_version": 1,
  "name": "oblivion-native-load-smoke",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--load-savegame={savegame}",
    "--no-sound=1",
    "--no-grab"
  ],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 25},
    {"type": "screenshot", "name": "oblivion-after-load.png"}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 10,
  "expected_exit": 0,
  "expected_log": [
    "Selected game profile: oblivion",
    "Loading saved game 'Quicksave' for character 'Prisoner'",
    "Loading cell ImperialDungeon01"
  ],
  "forbidden_log": [
    "Adding data directory .*vfs-mw",
    "neutral Oblivion compatibility",
    "GameSetting '.*' not found",
    "Failed to load saved game",
    "Saved game profile .*cannot be loaded",
    "TES4 runtime state requires missing content",
    "Error in frame",
    "onFrame failed",
    "Can't start .*scripts/omw",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted"
  ]
}
