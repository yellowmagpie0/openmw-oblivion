{
  "schema_version": 1,
  "name": "oblivion-m10-public-music",
  "cwd": "{source}",
  "environment": {
    "ALSOFT_DRIVERS": "wave",
    "ALSOFT_CONF": "{output}/config/alsoft.conf"
  },
  "files": [
    {
      "path": "config/alsoft.conf",
      "content": "[wave]\nfile = {output}/public-audio.wav\n"
    },
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=AnvilHorseWhisperer\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Sound]\nmaster volume = 1.0\nmusic volume = 0.4\nsfx volume = 1.0\nvoice volume = 1.0\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 24},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "public-music.png", "minimum_entropy": 0.04},
    {"type": "assert_file", "path_glob": "public-audio.wav", "expected_count": 1, "minimum_size": 100000}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 15,
  "expected_exit": 0,
  "expected_log": ["Opened \"Wave File Writer\"", "M10 native music state music/public:", "Playing \"music/public/", "M10 native interior environment: cell=AnvilHorseWhisperer"],
  "forbidden_log": ["Failed to (load|open) audio", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
