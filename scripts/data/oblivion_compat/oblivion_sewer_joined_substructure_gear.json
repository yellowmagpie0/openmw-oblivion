{
  "schema_version": 1,
  "name": "Joined chest armor, war axe and ordinary healing potion",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\nat 0 command content:oblivion.esm:01760f GetOpenState\nat 0 command content:oblivion.esm:01760f GetLocked\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal initial=nil\nreturn {{engineHandlers={{onFrame=function()\n local hp=Actor.stats.dynamic.health(self).current\n local inv=Actor.inventory(self)\n if not initial then initial=hp assert(inv:countOf(core.getFormId('Oblivion.esm',0x9310))==1,'Chest healing potion missing') print('Joined gear ready health='..hp) end\n local c,g,a=false,false,false\n for _,item in pairs(Actor.getEquipment(self)) do\n  if item.recordId==core.getFormId('Oblivion.esm',0x661c1) then c=true end\n  if item.recordId==core.getFormId('Oblivion.esm',0x661c3) then g=true end\n  if item.recordId==core.getFormId('Oblivion.esm',0x90613) then a=true end\n end\n if c then print('Joined cuirass equipped') end\n if c and g then print('Joined both armor equipped') end\n if a then print('Joined axe equipped') end\n if inv:countOf(core.getFormId('Oblivion.esm',0x9310))==0 and hp>initial then print('Joined potion healed health='..hp) end\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
