{
  "schema_version": 1,
  "name": "Real original Canosel bandit arrow hit and native Marksman-use observation",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": ""
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal NPC=require('openmw.types').NPC\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal util=require('openmw.util')\nlocal input=require('openmw.input')\nlocal t=0\nlocal held=0\nreturn {{engineHandlers={{onFrame=function(dt)\n if input.isMouseButtonPressed(1) then held=held+dt else held=0 end\n if held>=2 then print('VilverinContinueBow held two seconds') end\n t=t+dt;if t<.2 then return end;t=0\n local skill=NPC.stats.skills.marksman(self); print('Marksman sample base='..skill.base..' progress='..skill.progress)\n assert(not Actor.isDead(self),'Player died during original VilverinContinue acquisition')\n local target=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x6bfc2))\n assert(target and target:isValid(),'Actual Canosel bandit is unavailable')\n local aim=target:getBoundingBox().center+util.vector3(0,0,50)\n local p=camera.getViewTransform():apply(aim)\n local a=math.atan2(p.x,-p.z);local pitch=-math.atan2(p.y,math.sqrt(p.x*p.x+p.z*p.z))\n print(string.format('VilverinContinueAcquire aim x=%d y=%d',math.max(-150,math.min(150,math.floor(a*256+.5))),math.max(-100,math.min(100,math.floor(pitch*256+.5)))))\n local hit=nearby.castRay(self.position+util.vector3(0,0,109),aim,{{ignore=self}})\n print('VilverinContinueBow actor sample health='..Actor.stats.dynamic.health(self).current..' target_health='..Actor.stats.dynamic.health(target).current..' distance='..(target.position-self.position):length()..' hit='..tostring(hit.hitObject)..' pos='..tostring(self.position)..' target='..tostring(target.position))\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
