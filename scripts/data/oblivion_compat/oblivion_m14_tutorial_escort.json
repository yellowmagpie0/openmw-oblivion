  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "wait_log", "pattern": "M10 video playback: video.*OblivionIntro\\.bik", "timeout_seconds": 90},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key", "value": "Escape"},
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"selection\",\"actor\":\"content:oblivion.esm:032a18\",\"package\":\"content:oblivion.esm:032b47\"", "timeout_seconds": 30},
    {"type": "wait_log", "pattern": "M7 ObScript: autosave", "timeout_seconds": 30},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key_hold", "value": "s", "seconds": 1},
    {"type": "wait_log", "pattern": "sayto topic=.* info=", "timeout_seconds": 30},
    {"type": "wait_log", "pattern": "setstage quest=content:oblivion.esm:02466e stage=10", "timeout_seconds": 150},
    {"type": "wait_log", "pattern": "setstage quest=content:oblivion.esm:02466e stage=13", "timeout_seconds": 80},
    {"type": "sleep", "seconds": 2},
    {"type": "focus_window", "name": "OpenMW"},
