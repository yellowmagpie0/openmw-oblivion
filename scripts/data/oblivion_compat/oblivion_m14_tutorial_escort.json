    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 2, "minimum_size": 1024, "contains_ascii": ["T4ST", "OMW4STATE"]},
    {"type": "sleep", "seconds": 2}
