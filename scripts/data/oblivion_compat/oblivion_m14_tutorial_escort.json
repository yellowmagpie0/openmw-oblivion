{
  "schema_version": 1,
  "name": "oblivion-m14-tutorial-escort",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=1\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n"
    }
  ],
  "m14": {
    "event_file": "ai-events.jsonl",
    "fixed_seed": 1414,
    "minimum_event_count": 100,
    "required_events": [
      {"event": "selection"},
      {"event": "phase"},
      {"event": "route"}
    ],
    "required_event_order": [
      {"event": "selection"},
      {"event": "phase"}
    ],
    "actor_event_requirements": [
      {
        "actor": "content:oblivion.esm:032a18",
        "required_event_order": [
          {"event": "selection", "package": "content:oblivion.esm:032b47"},
          {"event": "selection", "package": "content:oblivion.esm:032ae8"},
          {"event": "route", "package": "content:oblivion.esm:032ae8"},
          {"event": "door-transition"}
        ],
        "minimum_event_counts": {"route": 2, "door-transition": 1},
        "maximum_event_counts": {"selection": 16, "route-blocked": 8},
        "forbidden_reason_substrings": ["bounded-repath-exhausted", "door-locked", "navmesh is not found"]
      },
      {
        "actor": "content:oblivion.esm:032a17",
        "required_event_order": [
          {"event": "selection", "package": "content:oblivion.esm:032b47"},
          {"event": "selection", "package": "content:oblivion.esm:032aeb"},
          {"event": "route", "package": "content:oblivion.esm:032aeb"},
          {"event": "door-transition"}
        ],
        "minimum_event_counts": {"route": 2, "door-transition": 1},
        "maximum_event_counts": {"selection": 16, "route-blocked": 8},
        "forbidden_reason_substrings": ["bounded-repath-exhausted", "door-locked", "navmesh is not found"]
      },
      {
        "actor": "content:oblivion.esm:032a16",
        "required_event_order": [
          {"event": "selection", "package": "content:oblivion.esm:032b47"},
          {"event": "selection", "package": "content:oblivion.esm:032aea"},
          {"event": "route", "package": "content:oblivion.esm:032aea"},
          {"event": "door-transition"}
        ],
        "minimum_event_counts": {"route": 2, "door-transition": 1},
        "maximum_event_counts": {"selection": 16, "route-blocked": 8},
        "forbidden_reason_substrings": ["bounded-repath-exhausted", "door-locked", "navmesh is not found"]
      },
      {
        "actor": "content:oblivion.esm:032a15",
        "required_event_order": [
          {"event": "selection", "package": "content:oblivion.esm:032b47"},
          {"event": "selection", "package": "content:oblivion.esm:032ae9"},
          {"event": "route", "package": "content:oblivion.esm:032ae9"},
          {"event": "door-transition"}
        ],
        "minimum_event_counts": {"route": 2, "door-transition": 1},
        "maximum_event_counts": {"selection": 16, "route-blocked": 8},
        "forbidden_reason_substrings": ["bounded-repath-exhausted", "door-locked", "navmesh is not found"]
      }
    ],
    "forbidden_event_names": ["direct-teleport", "tes3-ai", "unsupported", "unresolved", "phase-loop", "route-loop"],
    "forbidden_reason_substrings": ["direct-teleport", "tes3-ai", "unsupported", "unresolved-package", "deferred-m14"],
    "maximum_repeated_events": {"tier": 16},
    "maximum_route_blocked": 500,
    "maximum_no_progress_events": 500,
    "maximum_phase_repeat": 8
