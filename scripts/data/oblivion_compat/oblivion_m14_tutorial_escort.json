  "terminate_after_actions": true,
  "timeout_seconds": 300,
  "expected_exit": 0,
  "expected_log": ["Selected game profile: oblivion", "Starting a new game", "Writing saved game 'Autosave'", "Writing saved game 'Quicksave'", "Loading saved game 'Quicksave'"],
