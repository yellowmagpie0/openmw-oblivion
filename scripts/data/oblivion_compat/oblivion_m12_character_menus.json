{
  "schema_version": 1,
  "name": "oblivion-m12-real-character-record-menus",
  "cwd": "{source}",
  "files": [
    {"path": "config/openmw.cfg", "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01::ref=0x1fc41::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"},
    {"path": "config/settings.cfg", "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n"}
  ],
  "environment": {
    "OPENMW_OBSCRIPT_EVENTS": "{source}/scripts/data/oblivion_compat/m12_character_menu_events.txt",
    "OPENMW_OBSCRIPT_REPORT": "{output}/m12-character-report.json"
  },
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "virtual_gamepad": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 20},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "real-races.png", "minimum_entropy": 0.03},
    {"type": "key_held", "value": "Return"},
    {"type": "sleep", "seconds": 14},
    {"type": "screenshot", "name": "real-classes.png", "minimum_entropy": 0.03},
    {"type": "mouse_move_absolute", "x": 430, "y": 228},
    {"type": "mouse_click", "button": 1},
    {"type": "mouse_click", "button": 1},
    {"type": "sleep", "seconds": 14},
    {"type": "screenshot", "name": "real-birthsigns.png", "minimum_entropy": 0.03},
    {"type": "key_held", "value": "Return"},
    {"type": "sleep", "seconds": 2},
    {"type": "screenshot", "name": "configured-character-complete.png", "minimum_entropy": 0.03},
    {"type": "key_held", "value": "F5"},
    {"type": "sleep", "seconds": 6},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST"]},
    {"type": "assert_file", "path_glob": "m12-character-report.json", "expected_count": 1, "minimum_size": 256, "contains_ascii": ["\"birthsign\":\"content:oblivion.esm:", "\"character_generation_flags\":14"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 80,
  "expected_exit": 0,
  "expected_log": [
    "M7 ObScript: character_menu command=showracemenu",
    "M7 ObScript: character_menu command=showclassmenu",
    "M7 ObScript: character_menu command=showbirthsignmenu",
    "Writing saved game 'Quicksave'"
  ],
  "forbidden_log": ["Unsupported ObScript command show", "Error: Failed to create chargen window", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
