{
  "schema_version": 1,
  "name": "Normal chapel entry and pristine save before approaching Jiv",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ChorrolNorthernGoodsAndTrade::ref=0x0280fa::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=hackdirt-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:027815 GetStage\n"
    },
    {
      "path": "test-data/hackdirt-observer.omwscripts",
      "content": "PLAYER: hackdirt-observer.lua\n"
    },
    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal points={{{{-67415.0625,62237.015625,9834}},{{-67324.34375,62132.953125,9858}},{{-67324,62050,9910}}}}\nlocal index=1\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n timer=timer+dt;if timer<0.1 then return end;timer=0\n local tag,target,object\n if self.cell.isExterior then\n  if index<=#points then\n   tag=tostring(index);local p=points[index];target=util.vector3(p[1],p[2],p[3]);local v=target-self.position\n   if math.sqrt(v.x*v.x+v.y*v.y)<15 then print('JivChapel reached='..tag);index=index+1;return end\n  else tag='door';object=0x280e1 end\n else\n  print('JivChapel entered='..self.cell.name);tag='jiv';object=0x280da\n end\n if object then\n  local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',object));if not obj or not obj:isValid() then print('JivChapel absent='..tag);return end\n  target=obj.position+util.vector3(0,0,object==0x280da and 85 or 30)\n end\n local v=target-self.position;local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n local pitch=0\n if object then local c=target-camera.getPosition();pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y)) end\n if math.abs(angle)<0.06 and math.abs(pitch-camera.getPitch())<0.04 then print('JivChapel ready='..tag) end\n print(string.format('JivChapel aim x=%d y=%d tag=%s pos=%.2f,%.2f,%.2f distance=%.2f',math.max(-150,math.min(150,math.floor(angle*512+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*512+.5))),tag,self.position.x,self.position.y,self.position.z,v:length()))\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 640,
  "height": 360,
  "actions": [
