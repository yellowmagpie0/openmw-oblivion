{
  "schema_version": 1,
  "name": "Normal shaman axe fight with settled camera aim and fatigue-conserving swings",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\nat 0 command content:oblivion.esm:01760f GetOpenState\nat 0 command content:oblivion.esm:01760f GetLocked\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal Actor=require('openmw.types').Actor\nlocal nearby=require('openmw.nearby')\nlocal frames=0\nreturn {{engineHandlers={{onFrame=function(dt)\n frames=frames+1\n assert(not Actor.isDead(self) and Actor.stats.dynamic.health(self).current>0,'Player died in shaman fight')\n local target=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x3b52e))\n assert(target and target:isValid(),'Shaman missing')\n if frames==5 then print('Shaman camera fight ready') end\n if Actor.isDead(target) then print('Shaman dead') end\n local v=camera.getViewTransform():apply(target.position+util.vector3(0,0,55))\n local yaw=math.atan2(v.x,-v.z)\n local pitch=-math.atan2(v.y,math.sqrt(v.x*v.x+v.z*v.z))\n print(string.format('Shaman camera aim x=%d y=%d',math.max(-8192,math.min(8192,math.floor(yaw*5120+.5))),math.max(-8192,math.min(8192,math.floor(pitch*5120+.5)))))\n if frames%5==0 then print('Shaman fight player='..tostring(self.position)..' hp='..Actor.stats.dynamic.health(self).current..' target='..tostring(target.position)..' hp='..Actor.stats.dynamic.health(target).current) end\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
