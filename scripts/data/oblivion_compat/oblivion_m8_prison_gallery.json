{
  "schema_version": 1,
  "name": "oblivion-m8-prison-gallery",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 30},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "prison.png"},
    {"type": "key_held", "value": "F5"},
    {"type": "sleep", "seconds": 3},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 10,
  "expected_exit": 0,
  "expected_log": ["Loading cell ImperialDungeon01", "Writing saved game 'Quicksave'"],
  "forbidden_log": ["Failed to open image: Resource 'textures/(architecture|clutter|dungeons|oblivion|plants|weapons)", "shader.*failed", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
