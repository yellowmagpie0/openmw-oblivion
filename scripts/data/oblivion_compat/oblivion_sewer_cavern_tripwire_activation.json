  "schema_version": 1,
  "name": "Anchored mace release and second goblin",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal Actor=require('openmw.types').Actor\nlocal core=require('openmw.core')\nlocal nearby=require('openmw.nearby')\nlocal util=require('openmw.util')\nlocal frames=0\nlocal strike=0\nlocal wasUse=false\nlocal released=nil\nlocal done=false\nlocal selected=nil\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n frames=frames+1\n assert(Actor.stats.dynamic.health(self).current>0,'Player died in western rat fight')\n if frames==5 then print('Western rat fight ready') end\n local target=nil\n local distance=math.huge\n local dead=0\n for _,id in ipairs({{0x3b513}}) do\n  local rat=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n  assert(rat and rat:isValid(),'Western rat missing')\n  if Actor.isDead(rat) then dead=dead+1\n  else\n   local d=(rat.position-self.position):length()\n   if d<distance then target=rat distance=d end\n  end\n end\n if distance<170 then print('Western rat close approach') end\n if selected and selected:isValid() and not Actor.isDead(selected) then\n  target=selected distance=(target.position-self.position):length()\n else selected=target end\n local x=0\n if target then\n  local d=target.position-self.position\n  local f=self.rotation:apply(util.vector3(0,1,0))\n  local angle=math.atan2(f.y*d.x-f.x*d.y,f.x*d.x+f.y*d.y)\n  x=math.max(-8192,math.min(8192,math.floor(angle*5120+.5)))\n end\n print(string.format('Western rat aim x=%d y=0 distance=%.2f',x,distance))\n if not done and dead==1 then done=true print('Western rats defeated') end\n local use=self.controls.use~=0\n if use and not wasUse then strike=strike+1 released=nil print('Western strike '..strike..' armed') end\n if wasUse and not use then released=core.getSimulationTime() end\n if released and core.getSimulationTime()-released>=1 then print('Western strike '..strike..' settled') end\n wasUse=use\n timer=timer+dt\n if timer>=1 then timer=0 print('Western rat fight health='..Actor.stats.dynamic.health(self).current..' remaining='..(1-dead)) end\nend}}}}\n"
    }
  ],
  "command": [
