    "M7 ObScript: startcombat actor=content:oblivion.esm:0178c4(?:\\s|$)",
    "event=onhit unit=content:oblivion.esm:032ae1(?:@[^ ]+)? instance=content:oblivion.esm:032a15",
    "setstage quest=content:oblivion.esm:02466e stage=24(?:\\s|$)"
