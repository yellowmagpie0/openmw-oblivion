    "acceptance-command actor=content:oblivion.esm:014a2c name=GetDisabled result=0(?:\\s|$)",
    "acceptance-command actor=content:oblivion.esm:0178c3 name=GetDisabled result=0(?:\\s|$)",
    "acceptance-command actor=content:oblivion.esm:0178c4 name=GetDisabled result=0(?:\\s|$)",
    "setstage quest=content:oblivion.esm:02466e stage=23(?:\\s|$)",
    "setalert ref=content:oblivion.esm:032a18 value=1 applied=true",
    "setalert ref=content:oblivion.esm:032a15 value=1 applied=true",
    "setalert ref=content:oblivion.esm:032a16 value=1 applied=true",
    "setalert ref=content:oblivion.esm:032a17 value=1 applied=true",
    "M7 ObScript: startcombat actor=content:oblivion.esm:014a2c(?:\\s|$)",
