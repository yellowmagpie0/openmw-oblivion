  "terminate_after_actions": true,
  "timeout_seconds": 1200,
  "expected_exit": 0,
  "expected_log": [
    "setstage quest=content:oblivion.esm:02466e stage=18",
    "setstage quest=content:oblivion.esm:02466e stage=19"
  ],
  "forbidden_log": [
    "Unsupported ObScript command",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "TES4 AI update failed",
    "setstage quest=content:oblivion.esm:01e723 stage=24(?:\\s|$)"
  ],
  "reviewed_error_log": [
    "Failed to create audio decoder, can not play audio stream",
    "Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found",
    "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead"
  ],
  "virtual_gamepad": true,
  "environment": {
    "OPENMW_OBSCRIPT_EVENTS": "{output}/test-data/events.txt",
    "OPENMW_OBSCRIPT_REPORT": "{output}/script-report.json",
    "OPENMW_M15_EVENTS": "{output}/combat-events.jsonl",
    "OPENMW_M15_RUN_ID": "tutorial-player-intervention",
    "OPENMW_M15_EPOCH": "3",
    "OPENMW_OBLIVION_AI_EVENTS": "{output}/ai-events.jsonl",
    "OPENMW_OBLIVION_AI_SEED": "1414"
  },
  "sdl_xvfb_input": true
}
