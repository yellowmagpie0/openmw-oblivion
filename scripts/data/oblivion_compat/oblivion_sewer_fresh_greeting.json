    },
    {
      "type": "wait_log",
      "pattern": "Native dialogue menu: actor=content:oblivion.esm:032a18 info=content:oblivion.esm:02ad14",
      "timeout_seconds": 300,
      "abort_on_failure": true
    },
    {
      "type": "sleep",
