{
  "schema_version": 1,
  "name": "oblivion-m14-companion-travel-obstruction",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=18,-30::ref=0x62c7a::side=east\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "m14": {
    "event_file": "ai-events.jsonl",
    "fixed_seed": 1420,
    "minimum_event_count": 100,
    "required_events": [{"event": "route"}, {"event": "route-navmesh"}],
    "required_event_order": [{"event": "selection"}, {"event": "phase"}, {"event": "route"}],
    "actor_event_requirements": [
      {
        "actor": "content:oblivion.esm:062c78",
        "required_event_order": [{"event": "selection"}, {"event": "phase"}, {"event": "route"}],
        "minimum_event_counts": {"route": 1},
        "maximum_event_counts": {"route-blocked": 0},
        "forbidden_reason_substrings": ["bounded-repath-exhausted"]
      },
      {
        "actor": "content:oblivion.esm:062c7a",
        "required_event_order": [{"event": "selection"}, {"event": "phase"}, {"event": "route"}],
        "minimum_event_counts": {"route": 1},
        "maximum_event_counts": {"route-blocked": 0},
        "forbidden_reason_substrings": ["bounded-repath-exhausted"]
      },
      {
        "actor": "content:oblivion.esm:062c79",
        "required_event_order": [{"event": "selection"}, {"event": "phase"}, {"event": "route"}],
        "minimum_event_counts": {"route": 1},
        "maximum_event_counts": {"route-blocked": 0},
        "forbidden_reason_substrings": ["bounded-repath-exhausted"]
      }
    ],
    "forbidden_event_names": ["direct-teleport", "tes3-ai", "unsupported", "unresolved", "phase-loop", "route-loop"],
    "forbidden_reason_substrings": ["direct-teleport", "tes3-ai", "unsupported", "unresolved-package", "deferred-m14"],
    "maximum_repeated_events": {"tier": 16},
    "maximum_route_blocked": 1000,
    "maximum_no_progress_events": 1000,
    "maximum_phase_repeat": 8
  },
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"route\",\"actor\":\"content:oblivion.esm:062c79\"", "timeout_seconds": 120},
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"route\",\"actor\":\"content:oblivion.esm:062c7a\"", "timeout_seconds": 30},
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"route\",\"actor\":\"content:oblivion.esm:062c78\"", "timeout_seconds": 30},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "companion-initial.png", "minimum_entropy": 0.02},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 7},
    {"type": "m14_checkpoint", "name": "companion-initial", "minimum_actor_count": 3000, "minimum_companion_count": 2, "required_actor_keys": ["content:oblivion.esm:062c78", "content:oblivion.esm:062c7a", "content:oblivion.esm:062c79"], "required_package_types": [1, 7],
      "actor_state_requirements": [
        {"actor": "content:oblivion.esm:062c78", "expected": {"package_type": 7, "target": "content:oblivion.esm:062c7a", "companion_group": "content:oblivion.esm:062c7a", "formation_index": 0, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]},
        {"actor": "content:oblivion.esm:062c7a", "expected": {"package_type": 7, "target": "content:oblivion.esm:062c79", "companion_group": "content:oblivion.esm:062c79", "formation_index": 0, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]},
        {"actor": "content:oblivion.esm:062c79", "expected": {"package_type": 6, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]}
      ]},
    {"type": "m14_actor_distance", "checkpoint": "checkpoints/companion-initial.json", "actor": "content:oblivion.esm:062c7a", "target": "content:oblivion.esm:062c79", "maximum_distance": 512, "expected_same_cell": true},
    {"type": "m14_observe", "actor": "content:oblivion.esm:062c7a", "observation": "observations/companion-member-initial.json"},
    {"type": "m14_observe", "actor": "content:oblivion.esm:062c79", "observation": "observations/companion-leader-initial.json"},
    {"type": "m14_obstruction", "reference": "0xb5d5b", "operation": "add", "settle_seconds": 0.4},
    {"type": "sleep", "seconds": 8},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 7},
    {"type": "m14_checkpoint", "name": "companion-separated", "minimum_actor_count": 3000, "minimum_companion_count": 2, "required_actor_keys": ["content:oblivion.esm:062c78", "content:oblivion.esm:062c7a", "content:oblivion.esm:062c79"], "required_package_types": [1, 7],
      "actor_state_requirements": [
        {"actor": "content:oblivion.esm:062c78", "expected": {"package_type": 7, "target": "content:oblivion.esm:062c7a", "companion_group": "content:oblivion.esm:062c7a", "formation_index": 0, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]},
        {"actor": "content:oblivion.esm:062c7a", "expected": {"package_type": 7, "target": "content:oblivion.esm:062c79", "companion_group": "content:oblivion.esm:062c79", "formation_index": 0, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]},
        {"actor": "content:oblivion.esm:062c79", "expected": {"package_type": 6, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]}
      ]},
    {"type": "m14_actor_distance", "checkpoint": "checkpoints/companion-separated.json", "actor": "content:oblivion.esm:062c7a", "target": "content:oblivion.esm:062c79", "minimum_distance": 512},
    {"type": "m14_observe", "actor": "content:oblivion.esm:062c7a", "observation": "observations/companion-member-obstructed.json"},
    {"type": "m14_obstruction", "reference": "0xb5d5b", "operation": "remove", "settle_seconds": 0.4},
    {"type": "sleep", "seconds": 8},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 7},
    {"type": "m14_checkpoint", "name": "companion-reunited", "minimum_actor_count": 3000, "minimum_companion_count": 2, "required_actor_keys": ["content:oblivion.esm:062c78", "content:oblivion.esm:062c7a", "content:oblivion.esm:062c79"], "required_package_types": [1, 7],
      "actor_state_requirements": [
        {"actor": "content:oblivion.esm:062c78", "expected": {"package_type": 7, "target": "content:oblivion.esm:062c7a", "companion_group": "content:oblivion.esm:062c7a", "formation_index": 0, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]},
        {"actor": "content:oblivion.esm:062c7a", "expected": {"package_type": 7, "target": "content:oblivion.esm:062c79", "companion_group": "content:oblivion.esm:062c79", "formation_index": 0, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]},
        {"actor": "content:oblivion.esm:062c79", "expected": {"package_type": 6, "interruption_reason": ""}, "forbidden_values": {"phase": [8, 12]}, "required_truthy": ["has_destination"]}
      ]},
    {"type": "m14_actor_distance", "checkpoint": "checkpoints/companion-reunited.json", "actor": "content:oblivion.esm:062c7a", "target": "content:oblivion.esm:062c79", "maximum_distance": 512, "expected_same_cell": true},
    {"type": "m14_observe", "actor": "content:oblivion.esm:062c7a", "observation": "observations/companion-member-recovered.json"},
    {"type": "m14_debug_navigation", "settle_seconds": 0.3},
    {"type": "screenshot", "name": "companion-navmesh.png", "minimum_entropy": 0.02},
    {"type": "m14_assert_events", "minimum_event_count": 100, "required_events": [{"event": "route"}], "maximum_route_blocked": 1000, "maximum_no_progress_events": 1000},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST", "OMW4STATE"]},
    {"type": "key_held", "value": "grave"},
    {"type": "type", "value": "exit()", "delay_ms": 1},
    {"type": "key_held", "value": "Return"},
    {"type": "sleep", "seconds": 2}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 220,
  "expected_exit": 0,
  "expected_log": ["Selected game profile: oblivion", "Starting a new game", "Writing saved game 'Quicksave'"],
  "forbidden_log": ["Unsupported ObScript command", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"],
  "reviewed_error_log": ["Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found", "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead"]
}
