{
  "schema_version": 1,
  "name": "tutorial secret passage from legitimate post-greeting save",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n"
    }
  ],
  "m14": {
    "event_file": "ai-events.jsonl",
    "fixed_seed": 1414,
    "required_events": [
      {
        "event": "action-commit",
        "actor": "content:oblivion.esm:032a15",
        "package": "content:oblivion.esm:04d84d",
        "reason": "activator=content:oblivion.esm:04e90d"
      }
    ]
  },
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {
      "type": "wait_log",
      "pattern": "Applied TES4 runtime state:",
      "timeout_seconds": 90,
      "abort_on_failure": true
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "wait_log",
      "pattern": "setstage quest=content:oblivion.esm:02466e stage=19",
      "timeout_seconds": 60,
      "abort_on_failure": true
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "screenshot",
      "name": "secret-passage.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": -1
    },
    {
      "type": "sleep",
      "seconds": 3
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": 0
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "screenshot",
      "name": "passage-walk.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key",
      "value": "F5"
    },
    {
      "type": "sleep",
      "seconds": 4
    },
    {
      "type": "m14_checkpoint",
      "name": "after-passage",
      "save_name": "Quicksave",
      "minimum_actor_count": 3000
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 150,
  "expected_exit": 0,
  "expected_log": [
    "Applied TES4 runtime state:",
    "setstage quest=content:oblivion.esm:02466e stage=19"
  ],
  "forbidden_log": [
    "Unsupported ObScript command",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted",
    "TES4 AI update failed"
  ],
  "reviewed_error_log": [
    "Failed to create audio decoder, can not play audio stream",
    "Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found",
    "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead"
  ],
  "virtual_gamepad": true
}
