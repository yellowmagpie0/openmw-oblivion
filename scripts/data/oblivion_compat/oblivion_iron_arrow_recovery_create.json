{
  "schema_version": 1,
  "name": "Original Iron Arrow static recovery create",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command dynamic:player:0000000000000001 GetItemCount content:oblivion.esm:017829\nat 10 command dynamic:player:0000000000000001 GetItemCount content:oblivion.esm:017829\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal Actor=require('openmw.types').Actor\nlocal camera=require('openmw.camera')\nlocal util=require('openmw.util')\nlocal nearby=require('openmw.nearby')\nlocal input=require('openmw.input')\nlocal t=-1\nlocal held=0\nreturn {{engineHandlers={{onFrame=function(dt)\n if input.isMouseButtonPressed(1) then held=held+dt else held=0 end\n if held>=2 then print('VilverinContinue recovery held two seconds') end\n t=t+dt;if t<.2 then return end;t=0\n assert(not Actor.isDead(self),'Player died during real stone arrow baseline')\n local f=self.rotation:apply(util.vector3(0,1,0));local dv=util.vector3(0,1,0)\n local yaw=math.atan2(f.y*dv.x-f.x*dv.y,f.x*dv.x+f.y*dv.y)\n print(string.format('VilverinContinue recovery aim x=%d y=%d',math.max(-150,math.min(150,math.floor(yaw*256+.5))),math.max(-100,math.min(100,math.floor((.4-camera.getPitch())*256+.5)))))\n local origin=camera.getPosition();local hit=nearby.castRenderingRay(origin,origin+camera.viewportToWorldVector(util.vector2(.5,.5))*2000,{{ignore=self}})\n print('VilverinContinue recovery sample stance='..tostring(Actor.getStance(self))..' target='..tostring(hit.hitObject)..' point='..tostring(hit.hitPos)..' health='..Actor.stats.dynamic.health(self).current)\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
