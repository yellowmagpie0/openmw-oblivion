{
  "schema_version": 1,
  "name": "oblivion-m11-player-skeleton-and-transition-suite",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01::ref=0x1fc41::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 12},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "mouse_move", "x": 0, "y": 260},
    {"type": "key_held", "value": "f"},
    {"type": "sleep", "seconds": 2},
    {"type": "screenshot", "name": "first-person-arms.png", "minimum_entropy": 0.03},
    {"type": "key_held", "value": "Tab"},
    {"type": "sleep", "seconds": 3},
    {"type": "screenshot", "name": "third-person-player.png", "minimum_entropy": 0.03},
    {"type": "key_down", "value": "w"},
    {"type": "sleep", "seconds": 1},
    {"type": "screenshot", "name": "walk-transition.png", "minimum_entropy": 0.03},
    {"type": "key_up", "value": "w"},
    {"type": "sleep", "seconds": 1},
    {"type": "key_down", "value": "Shift_L"},
    {"type": "key_down", "value": "w"},
    {"type": "sleep", "seconds": 1},
    {"type": "screenshot", "name": "run-transition.png", "minimum_entropy": 0.03},
    {"type": "key_up", "value": "w"},
    {"type": "key_up", "value": "Shift_L"},
    {"type": "sleep", "seconds": 1},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 5},
    {"type": "key", "value": "F9"},
    {"type": "sleep", "seconds": 8},
    {"type": "screenshot", "name": "animation-reload.png", "minimum_entropy": 0.03},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 20,
  "expected_exit": 0,
  "expected_log": [
    "M11 player assembled: sex=.* view=first parts=[1-9]",
    "M11 player assembled: sex=.* view=third parts=[1-9]",
    "M11 player assembled: sex=.* view=third.*face_morph_meshes=[1-9]",
    "M11 animation loaded: ref=\"Player\" group=idle.*controllers=[1-9]",
    "M11 animation playing: ref=\"Player\" group=idle.*bound_controllers=[1-9]",
    "M11 animation loaded: ref=\"Player\" group=walkforward.*controllers=[1-9]",
    "M11 animation loaded: ref=\"Player\" group=runforward.*controllers=[1-9]",
    "Writing saved game 'Quicksave'"
  ],
  "forbidden_log": [
    "Unable to attach Oblivion player part",
    "Unable to load registered actor animation group",
    "can't find bone",
    "invalid transform",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted"
  ]
}
