scn M15StationaryOpponent
short fighting

Begin OnActivate
    if fighting == 0
        StartCombat Player
        set fighting to 1
    endif
End

Begin GameMode
    if fighting == 1
        if GetAV Fatigue < GetBaseAV Fatigue
            SetRestrained 1
            set fighting to 2
        endif
    endif
    if fighting >= 2
        if fighting < 122
            set fighting to fighting + 1
        endif
    endif
    if fighting == 122
        SetRestrained 0
        set fighting to 123
    endif
    if fighting == 123
        if GetAV Fatigue < 100
            SetRestrained 1
            set fighting to 124
        endif
    endif
End
