{
  "schema_version": 1,
  "name": "oblivion-m5-{label}",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart={start}\nskip-menu=1\nnew-game=0\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Input]\ncamera sensitivity = 0.1\n[Models]\nload unsupported nif files = true\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": [
    "{openmw}",
    "--no-grab=1",
    "--replace=config",
    "--config",
    "{output}/config"
  ],
  "environment": {
    "ALSOFT_DRIVERS": "null"
  },
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 20},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key_down", "value": "{look_lr_key}"},
    {"type": "sleep", "seconds": "{look_lr_seconds}"},
    {"type": "key_up", "value": "{look_lr_key}"},
    {"type": "key_down", "value": "{look_ud_key}"},
    {"type": "sleep", "seconds": "{look_ud_seconds}"},
    {"type": "key_up", "value": "{look_ud_key}"},
    {"type": "key_down", "value": "w"},
    {"type": "sleep", "seconds": "{approach_seconds}"},
    {"type": "key_up", "value": "w"},
    {"type": "screenshot", "name": "before.png"},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key", "value": "space"},
    {"type": "sleep", "seconds": 3},
    {"type": "key_down", "value": "w"},
    {"type": "sleep", "seconds": "{after_seconds}"},
    {"type": "key_up", "value": "w"},
    {"type": "sleep", "seconds": 2},
    {"type": "screenshot", "name": "after.png"},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 6},
    {
      "type": "assert_file",
      "path_glob": "userdata/saves/*/*.omwsave",
      "expected_count": 1,
      "minimum_size": 1024,
      "contains_ascii": ["T4ST", "OMW4STATE"]
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 10,
  "expected_exit": 0,
  "expected_log": [
    "Selected game profile: oblivion",
    "{expected_interaction}",
    "Writing saved game 'Quicksave'"
  ],
  "forbidden_log": [
    "Failed to load.*[Ss]ound",
    "GameSetting '.*' not found",
    "Failed to save game",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted"
  ]
}
