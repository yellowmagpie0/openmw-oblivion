{
  "schema_version": 1,
  "name": "Ordinary approach and activation of original door049424 into Vilverin Canosel after real corridor combat",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": ""
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal camera=require('openmw.camera')\nlocal util=require('openmw.util')\nlocal nearby=require('openmw.nearby')\nlocal t=-1\nlocal path=nil\nlocal step=2\nreturn {{engineHandlers={{onFrame=function(dt)\n t=t+dt;if t<.2 then return end;t=0\n assert(not Actor.isDead(self),'Player died during original VilverinContinue acquisition')\n if self.cell.name=='Vilverin02' then print('VilverinContinueDoor entered Canosel'); for _,id in ipairs({{0x6c2e4,0x4bb63,0x6c2c6}}) do local a=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id));if a and a:isValid() then print('CryptSkeleton fresh id='..id..' pos='..tostring(a.position)..' distance='..(a.position-self.position):length()..' health='..Actor.stats.dynamic.health(a).current) end end;return end\n local o=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x49424))\n local itemTarget=(o and o:isValid()) and o:getBoundingBox().center or util.vector3(-3659.155761,-5824.630859,-1912.975342)\n if not path then\n  local status,points=nearby.findPath(self.position,itemTarget,{{agentBounds=Actor.getPathfindingAgentBounds(self),destinationTolerance=256}})\n  if #points>1 then path=points;print('VilverinContinueWalk path ready');for i,p in ipairs(path) do print('VilverinContinueWalk original path '..i..' '..tostring(p)) end else print('VilverinContinueWalk waiting path status='..tostring(status)..' count='..#points);return end\n end\n for _,id in ipairs({{0x6c35c,0x6c35e}}) do\n  local enemy=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n  if enemy and enemy:isValid() and not Actor.isDead(enemy) then print('VilverinContinue enemy id='..id..' distance='..(enemy.position-self.position):length()..' health='..Actor.stats.dynamic.health(enemy).current) end\n end\n local target=step<=#path and path[step] or itemTarget\n local dv=target-self.position\n if step<=#path and math.sqrt(dv.x*dv.x+dv.y*dv.y)<18 then print('VilverinContinueWalk reached '..step);step=step+1;target=step<=#path and path[step] or itemTarget end\n local v=target-self.position;local f=self.rotation:apply(util.vector3(0,1,0));local a=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n local c=target-camera.getPosition();local pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y))\n if step<=#path then local p=camera.getViewTransform():apply(target);a=math.atan2(p.x,-p.z);pitch=camera.getPitch()-math.atan2(p.y,math.sqrt(p.x*p.x+p.z*p.z)) end\n print(string.format('VilverinContinueAcquire aim x=%d y=%d',math.max(-150,math.min(150,math.floor(a*256+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*256+.5)))))\n local d=v:length()\n print('VilverinContinueAcquire sample stock='..Actor.inventory(self):countOf(core.getFormId('Oblivion.esm',0x191))..' health='..Actor.stats.dynamic.health(self).current..' magicka='..Actor.stats.dynamic.magicka(self).current..' distance='..d..' pos='..tostring(self.position)..' paused='..tostring(core.isWorldPaused()))\n if d<190 then print('VilverinContinueAcquire within reach') end\nend}}}}\n"
    }
  ],
