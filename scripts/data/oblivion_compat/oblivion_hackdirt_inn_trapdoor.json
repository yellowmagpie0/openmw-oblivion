{
  "schema_version": 1,
  "name": "Original Hackdirt inn trapdoor entry with original Jiv key",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ChorrolNorthernGoodsAndTrade::ref=0x0280fa::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=hackdirt-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:027815 GetStage\n"
    },
    {
      "path": "test-data/hackdirt-observer.omwscripts",
      "content": "PLAYER: hackdirt-observer.lua\n"
    },
    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal Actor=require('openmw.types').Actor\nlocal points={{{{-209.44088745117188,-467.9173278808594,0.0}},{{-133.1930694580078,-358.9654541015625,0.0}},{{-2.8498008251190186,-236.7174072265625,2.0}},{{57.78220748901367,-172.15550231933594,2.0}},{{91.2643814086914,-97.06729888916016,2.0}},{{169.53721618652344,-51.46400451660156,0.0}},{{246.689208984375,-2.606792688369751,0.0}},{{326.45343017578125,37.55244445800781,0.0}},{{398.50421142578125,145.97894287109375,0.0}},{{388.38067626953125,245.0630340576172,0.0}},{{389.0908203125,347.551513671875,0.0}},{{291.9553527832031,445.66168212890625,2.0}},{{199.0653839111328,481.31915283203125,0.0}},{{155,490,1}}}}\nlocal index=1\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n timer=timer+dt;if timer<0.1 then return end;timer=0\n local tag,target,object\n if self.cell.name=='HackdirtCaverns' then print('InnTrap entered='..self.cell.name..' health='..Actor.stats.dynamic.health(self).current);for _,id in ipairs({{0x280fa,0x92c5a,0x92c5b,0x2813e}}) do local a=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id));if a and a:isValid() then print('CavernActor id='..id..' cell='..a.cell.name..' pos='..tostring(a.position)..' health='..Actor.stats.dynamic.health(a).current) end end;return end\n if self.cell.name~='HackdirtMoslinsInn' then print('InnTrap unexpected='..self.cell.name);return end\n if index<=#points then\n  tag=tostring(index);local p=points[index];target=util.vector3(p[1],p[2],p[3]);local v=target-self.position\n  if math.sqrt(v.x*v.x+v.y*v.y)<20 then print('InnTrap reached='..tag);index=index+1;return end\n else tag='door';object=0x28100 end\n if object then\n  local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',object));if not obj or not obj:isValid() then print('InnTrap absent='..tag);return end\n  target=obj.position+util.vector3(0,0,5)\n end\n local v=target-self.position\n if tag=='exit' and math.sqrt(v.x*v.x+v.y*v.y)<110 then print('InnTrap near=exit') end\n local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n local pitch=0\n if object then local c=target-camera.getPosition();pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y)) end\n if math.abs(angle)<0.06 and math.abs(pitch-camera.getPitch())<0.04 then print('InnTrap ready='..tag) end\n print(string.format('InnTrap aim x=%d y=%d tag=%s pos=%.2f,%.2f,%.2f distance=%.2f',math.max(-150,math.min(150,math.floor(angle*128+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*128+.5))),tag,self.position.x,self.position.y,self.position.z,v:length()))\nend}}}}\n"
    }
  ],
