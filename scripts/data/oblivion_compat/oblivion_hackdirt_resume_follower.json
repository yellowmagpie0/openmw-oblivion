    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ChorrolNorthernGoodsAndTrade::ref=0x0280fa::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=hackdirt-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:027815 GetStage\n"
    },
    {
      "path": "test-data/hackdirt-observer.omwscripts",
      "content": "PLAYER: hackdirt-observer.lua\n"
    },
    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal Actor=require('openmw.types').Actor\nlocal timer=0\nlocal index=1\nlocal points={{{{1076.77,1761.63,22}},{{898.01,1761.09,24}},{{752.96,1819.9,46}},{{760,1940,40}}}}\nreturn {{engineHandlers={{onFrame=function(dt)\n timer=timer+dt;if timer<0.1 then return end;timer=0\n local a=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x280fa));assert(a and a:isValid(),'Dar-Ma missing');assert(not Actor.isDead(a),'Dar-Ma died')\n if core.isWorldPaused() then print('DarmaWait paused');return end\n local v=a.position-self.position;\n if index<=#points then\n  local p=points[index];v=util.vector3(p[1],p[2],p[3])-self.position\n  if math.sqrt(v.x*v.x+v.y*v.y)<20 then print('DarmaWait reached='..index);index=index+1;return end\n end\nlocal distance=v:length();local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n local pitch=0\n if index>#points then local c=a.position+util.vector3(0,0,85)-camera.getPosition();pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y)) end\n print(string.format('DarmaWait status player=%s darma=%s distance=%.2f',tostring(self.position),tostring(a.position),distance))\n if index>#points and distance<110 then print('DarmaWait close') end\n if math.abs(angle)<0.05 and math.abs(pitch-camera.getPitch())<0.04 then print('DarmaWait ready='..index) end\n print(string.format('DarmaWait aim x=%d y=%d',math.max(-150,math.min(150,math.floor(angle*128+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*128+.5)))))\nend}}}}\n"
    }
  ],
