{
  "schema_version": 1,
  "name": "Use owned Heal Minor Wounds on actual Canosel fight injury",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": ""
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal types=require('openmw.types')\nlocal t=0\nlocal last=nil\nlocal healed=false\nreturn {{engineHandlers={{onFrame=function(dt)\n t=t+dt;if t<.2 then return end;t=0\n assert(not types.Actor.isDead(self),'Player died during original healing course')\n local health=types.Actor.stats.dynamic.health(self).current\n local skill=types.NPC.stats.skills.restoration(self)\n print('VilverinContinue healing sample health='..health..' magicka='..types.Actor.stats.dynamic.magicka(self).current..' restoration='..skill.base..' progress='..skill.progress)\n if last and health>last+.01 then healed=true end;last=health\n if healed then print('VilverinContinue healing occurred') end\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 640,
  "height": 360,
  "actions": [
    {
      "type": "wait_log",
      "pattern": "VilverinContinue healing sample",
      "timeout_seconds": 600,
      "abort_on_failure": true
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "key_hold",
      "value": "Tab",
      "seconds": 0.6
    },
    {
      "type": "sleep",
      "seconds": 0.6
    },
    {
      "type": "mouse_move_absolute",
      "x": 370,
      "y": 23
    },
    {
      "type": "mouse_down",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.2
    },
    {
      "type": "mouse_up",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.5
    },
    {
      "type": "mouse_move_absolute",
      "x": 400,
      "y": 230
    },
    {
      "type": "mouse_click",
      "button": 5
    },
    {
      "type": "mouse_click",
      "button": 5
    },
    {
      "type": "mouse_click",
      "button": 5
    },
    {
      "type": "mouse_click",
      "button": 5
    },
    {
      "type": "mouse_click",
      "button": 5
    },
    {
      "type": "sleep",
      "seconds": 0.6
    },
    {
      "type": "screenshot",
      "name": "owned-healing-before-selection.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "mouse_move_absolute",
      "x": 95,
      "y": 245
    },
    {
      "type": "mouse_down",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.2
    },
    {
      "type": "mouse_up",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.5
    },
    {
      "type": "screenshot",
      "name": "owned-Heal-Minor-Wounds-selected.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_hold",
      "value": "Escape",
      "seconds": 0.6
    },
    {
      "type": "key_hold",
      "value": "c",
      "seconds": 0.6
    },
    {
      "type": "wait_log",
      "pattern": "VilverinContinue healing occurred",
      "timeout_seconds": 300,
      "abort_on_failure": true
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "screenshot",
      "name": "actual-fight-injury-healed.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_down",
      "value": "F5"
    },
    {
      "type": "wait_log",
      "pattern": "Writing saved game 'Quicksave'",
      "timeout_seconds": 300,
      "poll_interval_seconds": 0.005,
      "abort_on_failure": true
    },
    {
      "type": "key_up",
      "value": "F5"
    },
    {
      "type": "wait_log",
      "path": "events.jsonl",
      "pattern": "\"event\"\\s*:\\s*\"save-complete\"",
      "timeout_seconds": 300,
      "abort_on_failure": true
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 1800,
  "expected_exit": 0,
  "expected_log": [
    "VilverinContinue healing occurred",
    "Writing saved game 'Quicksave'"
  ],
  "forbidden_log": [
    "AddressSanitizer",
    "runtime error:",
    "Player died during original VilverinContinue acquisition",
    "M16 Welkynd consumed:",
    "M16 potion attributes applied:",
    "M16 native scroll consumed:",
    "Error in frame",
    "onFrame failed"
  ],
  "reviewed_error_log": [
    "Failed to create audio decoder, can not play audio stream",
    "Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found",
    "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead",
    "Failed to load 'meshes/landscape/miscbutterfly02\\.nif': Unsupported NiPathInterpolator banking or flip-avoidance flags, using marker_error instead"
  ],
  "environment": {
    "OPENMW_OBSCRIPT_EVENTS": "{output}/test-data/events.txt",
    "OPENMW_OBLIVION_AI_EVENTS": "{output}/ai-events.jsonl",
    "OPENMW_M15_EVENTS": "{output}/events.jsonl",
    "OPENMW_M15_RUN_ID": "restoration-use-heal-sanitized",
    "OPENMW_M15_EPOCH": "1"
  },
  "sdl_input_timeout_seconds": 60,
  "virtual_gamepad": false
}
