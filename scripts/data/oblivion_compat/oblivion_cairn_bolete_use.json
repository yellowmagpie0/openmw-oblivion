{
  "schema_version": 1,
  "name": "Original harvested Cairn Bolete one use and partial save",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command dynamic:player:0000000000000001 GetAV Health\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal frames=0\nreturn {{engineHandlers={{onFrame=function()\n frames=frames+1;if frames<30 or frames%5~=0 then return end\n assert(not Actor.isDead(self),'Player died during original Cairn Bolete use')\n print('CairnUse stock='..Actor.inventory(self):countOf(core.getFormId('Oblivion.esm',0x6251e))..' health='..Actor.stats.dynamic.health(self).current..' paused='..tostring(core.isWorldPaused()))\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 640,
  "height": 360,
  "actions": [
    {
      "type": "wait_log",
      "pattern": "CairnUse stock=1 health=67",
      "timeout_seconds": 600,
      "abort_on_failure": true
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "sleep",
      "seconds": 0.2
    },
    {
      "type": "key_hold",
      "value": "Tab",
      "seconds": 0.6
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "mouse_move_absolute",
      "x": 260,
      "y": 23
    },
    {
      "type": "mouse_click",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "screenshot",
      "name": "before-cairn-filter.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "mouse_move_absolute",
      "x": 503,
      "y": 95
    },
    {
      "type": "sleep",
      "seconds": 0.5
    },
    {
      "type": "mouse_down",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.15
    },
    {
      "type": "mouse_up",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "mouse_move_absolute",
      "x": 134,
      "y": 180
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "screenshot",
      "name": "earned-cairn-baseline-tooltip.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "sleep",
      "seconds": 60
    },
    {
      "type": "key_down",
      "value": "Control_L"
    },
    {
      "type": "mouse_down",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.2
    },
    {
      "type": "mouse_up",
      "button": 1
    },
    {
      "type": "key_up",
      "value": "Control_L"
    },
    {
