    {
      "type": "wait_log",
      "pattern": "TES4 ingredient consumed: ingredient=content:oblivion.esm:06251e magnitude=1 duration=3",
      "timeout_seconds": 30,
      "abort_on_failure": true
    },
    {
      "type": "screenshot",
      "name": "earned-cairn-baseline-consumed.png",
      "minimum_entropy": 0.02
