{
  "schema_version": 1,
  "name": "oblivion-m14-companion-telepe-preflight",
  "cwd": "{source}",
  "files": [
    {"path": "config/openmw.cfg", "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=18,-33::ref=0x17585::side=east\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"},
    {"path": "config/settings.cfg", "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n"}
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "m14": {
    "event_file": "ai-events.jsonl", "fixed_seed": 1420,
    "minimum_event_count": 100,
    "actor_event_requirements": [
      {"actor": "content:oblivion.esm:062c79", "required_event_order": [{"event": "selection"}, {"event": "route"}, {"event": "door-transition"}], "maximum_event_counts": {"route-blocked": 0}},
      {"actor": "content:oblivion.esm:062c7a", "required_event_order": [{"event": "selection"}, {"event": "route"}, {"event": "door-transition"}], "maximum_event_counts": {"route-blocked": 0}},
      {"actor": "content:oblivion.esm:062c78", "required_event_order": [{"event": "selection"}, {"event": "route"}, {"event": "door-transition"}], "maximum_event_counts": {"route-blocked": 0}}
    ],
    "forbidden_event_names": ["direct-teleport", "tes3-ai", "unsupported", "unresolved", "phase-loop", "route-loop"],
    "maximum_route_blocked": 1000, "maximum_no_progress_events": 1000
  },
  "xvfb": true, "width": 1280, "height": 720,
  "actions": [
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"route\",\"actor\":\"content:oblivion.esm:062c79\"", "timeout_seconds": 120},
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"door-transition\",\"actor\":\"content:oblivion.esm:062c79\"", "timeout_seconds": 200},
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"door-transition\",\"actor\":\"content:oblivion.esm:062c7a\"", "timeout_seconds": 45},
    {"type": "wait_log", "path": "ai-events.jsonl", "pattern": "\"event\":\"door-transition\",\"actor\":\"content:oblivion.esm:062c78\"", "timeout_seconds": 45},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key", "value": "F5"}, {"type": "sleep", "seconds": 7},
    {"type": "m14_checkpoint", "name": "telepe-arrival", "minimum_actor_count": 3000, "minimum_companion_count": 2,
      "actor_state_requirements": [
        {"actor": "content:oblivion.esm:062c79", "expected": {"cell": "content:oblivion.esm:016637"}},
        {"actor": "content:oblivion.esm:062c7a", "expected": {"cell": "content:oblivion.esm:016637", "target": "content:oblivion.esm:062c79"}},
        {"actor": "content:oblivion.esm:062c78", "expected": {"cell": "content:oblivion.esm:016637", "target": "content:oblivion.esm:062c7a"}}
      ]},
    {"type": "sleep", "seconds": 2}
  ],
  "terminate_after_actions": true, "timeout_seconds": 440, "expected_exit": 0,
  "expected_log": ["Selected game profile: oblivion", "Starting a new game", "Writing saved game 'Quicksave'"],
  "forbidden_log": ["Unsupported ObScript command", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted", "Console diagnostic:"],
  "reviewed_error_log": ["Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found", "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead"]
}
