{
  "schema_version": 1,
  "name": "Player normally approaches original unlocked Sanctum transition",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal Actor=require('openmw.types').Actor\nlocal nearby=require('openmw.nearby')\nlocal points={{util.vector3(1100,7220,-1212),util.vector3(1033,7139,-1236),util.vector3(1008,7048,-1247),util.vector3(983,6955,-1247),util.vector3(917,6867,-1247),util.vector3(883,6764,-1247),util.vector3(813,6683,-1229),util.vector3(778,6587,-1183),util.vector3(776,6476,-1183),util.vector3(775,6368,-1183)}}\nlocal step=1\nlocal ready=false\nlocal frames=0\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n frames=frames+1\n assert(Actor.stats.dynamic.health(self).current>0,'Player died during cavern traversal')\n if frames>=5 and not ready then\n  local c,g=false,false\n  for _,item in pairs(Actor.getEquipment(self)) do\n   if item.recordId==core.getFormId('Oblivion.esm',0x661c1) then c=true end\n   if item.recordId==core.getFormId('Oblivion.esm',0x661c3) then g=true end\n  end\n  assert(c and g,'Both armor pieces required') ready=true print('Substructure corridor ready')\n end\n if math.abs(camera.getPitch())<.025 then print('Substructure camera level') end\n if step<=#points then\n  local d=points[step]-self.position\n  local distance=math.sqrt(d.x*d.x+d.y*d.y)\n  if distance<25 then print('Substructure waypoint '..step..' reached') step=step+1\n  else\n   local c=camera.getPosition()\n   local v=camera.getViewTransform():apply(util.vector3(c.x+d.x,c.y+d.y,c.z))\n   local angle=math.atan2(v.x,-v.z)\n   if math.abs(angle)<.04 then print('Substructure waypoint '..step..' facing') end\n   local x=math.max(-8192,math.min(8192,math.floor(angle*5120+.5)))\n   local y=math.floor(-camera.getPitch()*5120+.5)\n   print(string.format('Substructure waypoint %d aim x=%d y=%d',step,x,y))\n  end\n end\n timer=timer+dt\n if timer>1 then timer=0\n  print('Substructure corridor Player '..tostring(self.position)..' health='..Actor.stats.dynamic.health(self).current..' pitch='..camera.getPitch())\n  for _,id in ipairs({{0x32a16,0x32a18,0x32a17}}) do\n   local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n   if obj and obj:isValid() then print('Substructure encounter '..id..' pos='..tostring(obj.position)..' dead='..tostring(Actor.isDead(obj))..' health='..Actor.stats.dynamic.health(obj).current) end\n  end\n end\nend}}}}\n"
    }
  ],
  "command": [
