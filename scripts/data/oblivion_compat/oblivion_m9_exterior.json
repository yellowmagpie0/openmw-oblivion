{
  "schema_version": 1,
  "name": "oblivion-m9-{scene}",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart={start}\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n[Terrain]\ndistant terrain = true\nobject paging = true\nobject paging active grid = true\nlod factor = 0.5\n[Groundcover]\nenabled = false\ndensity = 1\nrendering distance = 12288\n[Camera]\nviewing distance = 65536\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 35},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "{scene}-initial.png", "minimum_entropy": 0.005},
    {"type": "key_down", "value": "w"},
    {"type": "sleep", "seconds": 8},
    {"type": "key_up", "value": "w"},
    {"type": "mouse_move", "x": 280, "y": -80},
    {"type": "sleep", "seconds": 8},
    {"type": "screenshot", "name": "{scene}-paged.png", "minimum_entropy": 0.08},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 3},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 512}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 12,
  "expected_exit": 0,
  "expected_log": ["Loading cell", "M9 native groundcover enabled", "M9 native groundcover populated"],
  "forbidden_log": ["Failed to open image: Resource 'textures/(landscape|plants|trees)", "shader.*failed", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
