{
  "schema_version": 1,
  "name": "Earn Security level6 on actual Canosel Gate049bba and inspect Stats",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal NPC=require('openmw.types').NPC\nlocal nearby=require('openmw.nearby')\nlocal camera=require('openmw.camera')\nlocal util=require('openmw.util')\nlocal elapsed=0\nlocal routeStage=1\nreturn {{engineHandlers={{onFrame=function(dt)\n elapsed=elapsed+dt;if elapsed<.2 then return end;elapsed=0\n local security=NPC.stats.skills.security(self)\n print('VilverinContinue Security sample base='..security.base..' progress='..security.progress)\n assert(not Actor.isDead(self),'Player died approaching authored iron gate')\n local gate=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x49bba))\n assert(gate and gate:isValid(),'Authored iron gate unavailable')\n local bounds=gate:getBoundingBox()\n local target=bounds.center-util.vector3(0,0,bounds.halfSize.z*.6)\n if routeStage==1 and self.position.y>-10800 then routeStage=2 end\n if routeStage==2 and self.position.x>-4890 then routeStage=3 end\n print('VilverinContinue route stage='..routeStage)\n if routeStage==1 then target=util.vector3(-5303,-10752,-2600) end\n if routeStage==2 then target=util.vector3(-4800,-10752,-2600) end\n local delta=target-self.position\n local distance=math.sqrt(delta.x*delta.x+delta.y*delta.y)\n print('VilverinContinue gate geometry center='..tostring(target))\n local eye=camera.getPosition()\n local direction=camera.viewportToWorldVector(util.vector2(.5,.5)):normalize()\n local ray=nearby.castRenderingRay(eye,eye+direction*145,{{ignore=self}})\n if ray.hitObject and ray.hitObject.id==gate.id then print('VilverinContinue gate focus confirmed') end\n print('VilverinContinue gate ray object='..tostring(ray.hitObject and ray.hitObject.id)..' distance='..tostring(ray.hitPos and (ray.hitPos-eye):length()))\n local p=camera.getViewTransform():apply(target)\n local yaw=math.atan2(p.x,-p.z)\n local pitch=-math.atan2(p.y,math.sqrt(p.x*p.x+p.z*p.z))\n print(string.format('VilverinContinue gate aim x=%d y=%d',math.max(-150,math.min(150,math.floor(yaw*64+.5))),math.max(-100,math.min(100,math.floor(pitch*64+.5)))))\n print('VilverinContinue gate first_person='..tostring(camera.getMode()==camera.MODE.FirstPerson))\n print('VilverinContinue gate sample pos='..tostring(self.position)..' distance='..distance..' health='..Actor.stats.dynamic.health(self).current)\n if routeStage==3 and distance<90 then print('VilverinContinue gate reached') end\nend}}}}\n"
    },
    {
      "path": "test-data/events.txt",
      "content": ""
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
