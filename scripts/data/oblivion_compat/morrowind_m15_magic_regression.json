      "value": "player->SetRestoration 100",
      "delay_ms": 2
    },
    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "type",
      "value": "player->SetWillpower 100",
      "delay_ms": 2
    },
    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "type",
      "value": "player->SetLuck 100",
      "delay_ms": 2
