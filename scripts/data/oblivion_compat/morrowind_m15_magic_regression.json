    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "key_held",
      "value": "grave"
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "key_held",
      "value": "grave"
    },
    {
      "type": "type",
      "value": "player->SetHealth 100",
      "delay_ms": 2
    },
    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "type",
      "value": "player->SetMagicka 100",
      "delay_ms": 2
    },
    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "type",
      "value": "player->SetFatigue 200",
      "delay_ms": 2
    },
    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "type",
      "value": "player->ModCurrentHealth -75",
      "delay_ms": 2
    },
    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "type",
      "value": "player->Cast \"hearth heal\" player",
      "delay_ms": 2
    },
    {
      "type": "key_held",
      "value": "Return"
    },
    {
      "type": "sleep",
      "seconds": 0.25
    },
    {
      "type": "key_held",
      "value": "grave"
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "key",
      "value": "F5"
    },
    {
      "type": "sleep",
      "seconds": 3
    },
    {
      "type": "command",
      "command": [
        "python3",
        "-c",
        "from pathlib import Path; import shutil; p=list(Path('userdata/saves').glob('*/*.omwsave')); assert len(p)==1; shutil.copyfile(p[0],'before-cast.omwsave')"
      ]
    },
    {
      "type": "screenshot",
      "name": "before-cast.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_held",
      "value": "r"
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "mouse_down",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.2
    },
    {
      "type": "mouse_up",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 3
    },
    {
      "type": "screenshot",
      "name": "after-cast.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key",
      "value": "F5"
    },
    {
      "type": "sleep",
      "seconds": 3
    },
    {
      "type": "assert_file",
      "path_glob": "userdata/saves/*/*.omwsave",
      "expected_count": 1,
      "minimum_size": 1024,
      "forbidden_ascii": [
        "GPRO",
        "T4VR",
        "T4ST",
        "OMW4STATE"
      ]
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 180,
  "expected_exit": 0,
  "expected_log": [
    "Loading content file Morrowind.esm",
