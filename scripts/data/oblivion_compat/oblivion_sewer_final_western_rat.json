{
  "schema_version": 1,
  "name": "Final sewer western rat encounter through normal axe attack",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\nat 0 command content:oblivion.esm:01760f GetOpenState\nat 0 command content:oblivion.esm:01760f GetLocked\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal Actor=require('openmw.types').Actor\nlocal nearby=require('openmw.nearby')\nlocal points={{util.vector3(-2614.3,955.8,6876),util.vector3(-2615.5,827.8,6848),util.vector3(-2501.2,850.4,6812),util.vector3(-2418.9,852.3,6754),util.vector3(-2295.3,841.7,6676),util.vector3(-2133.7,852.3,6562),util.vector3(-2030,784.4,6542),util.vector3(-2006.4,684.8,6542),util.vector3(-1868.4,610.1,6524),util.vector3(-1162.4,599.3,6524),util.vector3(-1009.6,347.3,6542)}}\nlocal step=1\nlocal frames=0\nreturn {{engineHandlers={{onFrame=function(dt)\n frames=frames+1\n local rat=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x666a7))\n if rat and rat:isValid() then\n  if Actor.isDead(rat) then print('Final western rat dead') end\n  local v=camera.getViewTransform():apply(rat.position+util.vector3(0,0,25))\n  local yaw=math.atan2(v.x,-v.z)\n  local pitch=-math.atan2(v.y,math.sqrt(v.x*v.x+v.z*v.z))\n  print(string.format('Final western rat aim x=%d y=%d',math.max(-8192,math.min(8192,math.floor(yaw*5120+.5))),math.max(-8192,math.min(8192,math.floor(pitch*5120+.5)))))\n end\n assert(Actor.stats.dynamic.health(self).current>0,'Player died in final sewers')\n if frames==5 then print('Final sewer traversal ready') end\n if step<=#points then\n  local d=points[step]-self.position\n  if math.sqrt(d.x*d.x+d.y*d.y)<25 then\n   print('Final sewer waypoint '..step..' reached') step=step+1\n  else\n   local c=camera.getPosition()\n   local v=camera.getViewTransform():apply(util.vector3(c.x+d.x,c.y+d.y,c.z))\n   local angle=math.atan2(v.x,-v.z)\n   print(string.format('Final sewer waypoint %d aim x=%d y=%d',step,math.max(-8192,math.min(8192,math.floor(angle*5120+.5))),math.floor(-camera.getPitch()*5120+.5)))\n  end\n end\n if frames%5==0 then\n  print('Final sewer pos '..tostring(self.position)..' health='..Actor.stats.dynamic.health(self).current)\n  for _,id in ipairs({{0x666a7,0x66a02,0x66a03,0x66a04,0x666da}}) do\n   local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n   if obj and obj:isValid() then print('Final sewer creature '..id..' pos='..tostring(obj.position)..' dead='..tostring(Actor.isDead(obj))..' hp='..Actor.stats.dynamic.health(obj).current) end\n  end\n end\nend}}}}\n"
    }
  ],
