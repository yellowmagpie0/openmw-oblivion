{
  "schema_version": 1,
  "name": "Continue healthy original Canosel camp past sarcophagus, pressure plate and secret wall",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": ""
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal camera=require('openmw.camera')\nlocal util=require('openmw.util')\nlocal nearby=require('openmw.nearby')\nlocal t=-2\nlocal path=nil\nlocal step=2\nlocal coffin=false\nlocal plateReached=false\nreturn {{engineHandlers={{onFrame=function(dt)\n t=t+dt;if t<.2 then return end;t=0\n assert(not Actor.isDead(self),'Player died during genuine healthy Canosel continuation')\n local plate=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x6bf96))\n local wall=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x6bf95))\n if not plate or not wall or not plate:isValid() or not wall:isValid() then return end\n if not path then local status,points=nearby.findPath(self.position,plate.position,{{agentBounds=Actor.getPathfindingAgentBounds(self),destinationTolerance=20}})\n if #points<2 then return end;path=points;print('VilverinContinue healthy path ready status='..tostring(status)) end\n if self.position.x>-3920 and math.abs(self.position.y+6656)<130 then coffin=true end\n if coffin then print('VilverinContinue healthy coffin near') end\n if (plate.position-self.position):length()<45 then plateReached=true end\n if plateReached then print('VilverinContinue healthy plate reached') end\n local target\n if plateReached then target=wall.position+util.vector3(0,-198,0)\n elseif coffin then target=plate.position\n else\n  target=step<=#path and path[step] or plate.position\n  local d=target-self.position\n  if step<=#path and math.sqrt(d.x*d.x+d.y*d.y)<40 then step=step+1;target=step<=#path and path[step] or plate.position end\n end\n local dv=target-self.position;local f=self.rotation:apply(util.vector3(0,1,0))\n local yaw=math.atan2(f.y*dv.x-f.x*dv.y,f.x*dv.x+f.y*dv.y)\n print(string.format('VilverinContinue healthy aim x=%d y=%d',math.max(-150,math.min(150,math.floor(yaw*256+.5))),math.max(-100,math.min(100,math.floor(-camera.getPitch()*256+.5)))))\n print('VilverinContinue healthy sample pos='..tostring(self.position)..' health='..Actor.stats.dynamic.health(self).current..' distance='..math.sqrt(dv.x*dv.x+dv.y*dv.y))\n if plateReached and math.sqrt(dv.x*dv.x+dv.y*dv.y)<45 then print('VilverinContinue healthy passage reached') end\nend}}}}\n"
    }
  ],
