{
  "schema_version": 1,
  "name": "Original Chorrol chair: cold seated restore and empty-target Activate getup",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ChorrolNorthernGoodsAndTrade::ref=0x0280fa::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=hackdirt-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:027815 GetStage\nat 0 command dynamic:player:0000000000000001 GetInCell content:oblivion.esm:024802\n"
    },
    {
      "path": "test-data/hackdirt-observer.omwscripts",
      "content": "PLAYER: hackdirt-observer.lua\n"
    },
    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal camera=require('openmw.camera')\nlocal types=require('openmw.types')\nlocal t=0\nreturn {{engineHandlers={{onFrame=function(dt)\n t=t+dt;if t<.2 then return end;t=0\n assert(not types.Actor.isDead(self),'Player died during original chair course')\n assert(self.cell.name=='ChorrolCastleGreatHall','Original chair course left Great Hall')\n local mode=camera.getMode()\n if camera.getPitch() < -1 then print('LeftSeat empty upward view') end\n print('LeftSeat pitch='..camera.getPitch())\n print('LeftSeat alive position='..tostring(self.position))\n print('LeftSeatView first='..tostring(mode==camera.MODE.FirstPerson)..' third='..tostring(mode==camera.MODE.ThirdPerson))\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 640,
  "height": 360,
  "actions": [
    {
      "type": "wait_log",
      "pattern": "\"event\"\\s*:\\s*\"load-complete\"",
      "timeout_seconds": 900,
      "abort_on_failure": true,
      "path": "events.jsonl"
    },
    {
      "type": "wait_log",
      "pattern": "LeftSeat alive",
      "timeout_seconds": 180,
      "abort_on_failure": true
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "screenshot",
      "name": "cold-original-left-chair-seated.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_hold",
      "value": "r",
      "seconds": 0.06
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "wait_log",
      "pattern": "LeftSeatView first=true third=false",
      "after_start": true,
      "timeout_seconds": 90,
      "abort_on_failure": true
    },
    {
      "type": "mouse_move",
      "x": 1,
      "y": 0
    },
    {
      "type": "sleep",
      "seconds": 0.5
    },
    {
      "type": "repeat_until_log",
      "pattern": "LeftSeat empty upward view",
      "after_start": true,
      "maximum_iterations": 80,
      "timeout_seconds": 180,
      "abort_on_failure": true,
      "actions": [
        {
          "type": "mouse_move",
          "x": 0,
          "y": -150
        },
        {
          "type": "wait_log",
          "pattern": "LeftSeat pitch=",
          "after_start": true,
          "timeout_seconds": 30,
          "abort_on_failure": true
        }
      ]
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "screenshot",
      "name": "left-chair-empty-target-before-getup.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_hold",
      "value": "space",
      "seconds": 0.2
    },
    {
      "type": "wait_log",
      "pattern": "Native Player furniture: phase=4",
      "timeout_seconds": 180,
      "abort_on_failure": true
    },
    {
      "type": "wait_log",
      "pattern": "Native Player furniture: phase=0",
      "timeout_seconds": 180,
      "abort_on_failure": true
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "screenshot",
      "name": "left-chair-standing-after-getup.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_hold",
      "value": "F5",
      "seconds": 0.3
    },
    {
      "type": "wait_log",
      "pattern": "\"event\"\\s*:\\s*\"save-complete\"",
      "timeout_seconds": 180,
      "abort_on_failure": true,
      "path": "events.jsonl"
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 1800,
  "expected_exit": 0,
  "expected_log": [
    "M5 activation focus: result=empty",
    "Native Player furniture: phase=4",
    "Native Player furniture: phase=0",
    "Writing saved game"
  ],
  "forbidden_log": [
    "Unsupported ObScript command",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted",
    "TES4 AI update failed",
    "conversation-player ref=content:oblivion.esm:0280fa",
    "Native dialogue menu: actor=content:oblivion.esm:0280fa info=content:oblivion.esm:02809c",
    "Native dialogue menu:",
    "Native Player furniture: cancelled",
    "Failed to save game",
    "Unsupported Player furniture entry marker"
  ],
  "reviewed_error_log": [
    "Failed to create audio decoder, can not play audio stream",
    "Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found",
    "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead"
  ],
  "environment": {
    "OPENMW_OBSCRIPT_EVENTS": "{output}/test-data/events.txt",
    "OPENMW_M15_EVENTS": "{output}/events.jsonl",
    "OPENMW_M15_RUN_ID": "original_chorrol_left_seat_getup",
    "OPENMW_M15_EPOCH": "1"
  },
  "sdl_xvfb_input": true,
  "sdl_input_timeout_seconds": 180,
  "virtual_gamepad": false
}
