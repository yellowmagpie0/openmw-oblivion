{
  "schema_version": 1,
  "name": "oblivion-m10-weather-matrix",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=OldBridgeExterior\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n[Terrain]\ndistant terrain = true\nobject paging = true\n[Groundcover]\nenabled = false\n[Camera]\nviewing distance = 65536\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 35},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key_held", "value": "grave"},
    {"type": "type_held", "value": "lua player"},
    {"type": "key_held", "value": "Return"},
    {"type": "type", "value": "for _,w in ipairs(core.weather.records) do if w.name=='Clear' then core.weather.changeWeather('',w); print('M10_STATE request '..w.name) end end", "delay_ms": 1},
    {"type": "key_held", "value": "Return"},
    {"type": "type", "value": "exit()", "delay_ms": 1},
    {"type": "key_held", "value": "Return"},
    {"type": "type_held", "value": "lua global"},
    {"type": "key_held", "value": "Return"},
    {"type": "type", "value": "world.advanceTime(1); exit()", "delay_ms": 1},
    {"type": "key_held", "value": "Return"},
    {"type": "key_held", "value": "grave"},
    {"type": "sleep", "seconds": 3},
    {"type": "screenshot", "name": "01-clear.png", "minimum_entropy": 0.06},

