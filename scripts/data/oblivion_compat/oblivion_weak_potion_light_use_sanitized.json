{
  "schema_version": 1,
  "name": "Drink the earned Weak Potion of Light and save its active effect under ASan and UBSan",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": ""
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal t=0\nreturn {{engineHandlers={{onFrame=function(dt)\n t=t+dt;if t<.2 then return end;t=0\n assert(not Actor.isDead(self),'Player died during original potion inventory survey')\n print('VilverinContinue potion stock='..Actor.inventory(self):countOf(core.getFormId('Oblivion.esm',0x9847f))..' health='..Actor.stats.dynamic.health(self).current..' magicka='..Actor.stats.dynamic.magicka(self).current..' fatigue='..Actor.stats.dynamic.fatigue(self).current..' paused='..tostring(core.isWorldPaused()))\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 640,
  "height": 360,
  "actions": [
    {
      "type": "wait_log",
      "pattern": "VilverinContinue potion stock=1",
      "timeout_seconds": 420,
      "abort_on_failure": true
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "screenshot",
      "name": "fixed-view-before-potion.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "key_hold",
      "value": "Tab",
      "seconds": 0.6
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "mouse_move_absolute",
      "x": 270,
      "y": 23
    },
    {
      "type": "mouse_click",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.6
    },
    {
      "type": "mouse_move_absolute",
      "x": 490,
      "y": 95
    },
    {
      "type": "mouse_click",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.6
    },
    {
      "type": "mouse_move_absolute",
      "x": 135,
      "y": 140
    },
    {
      "type": "sleep",
      "seconds": 0.5
    },
    {
      "type": "screenshot",
      "name": "original-potion-light-tooltip-before-use.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_down",
      "value": "Control_L"
    },
    {
      "type": "mouse_down",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.2
    },
    {
      "type": "mouse_up",
      "button": 1
    },
    {
      "type": "key_up",
      "value": "Control_L"
    },
    {
      "type": "sleep",
      "seconds": 0.4
    },
    {
      "type": "mouse_move_absolute",
      "x": 50,
      "y": 205
    },
    {
      "type": "sleep",
      "seconds": 0.3
    },
    {
      "type": "mouse_down",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.2
    },
    {
      "type": "mouse_up",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "wait_log",
      "pattern": "M16 potion Light applied: potion=content:oblivion.esm:09847f",
      "timeout_seconds": 20,
      "abort_on_failure": true
    },
    {
      "type": "screenshot",
      "name": "original-potion-light-use-attempt.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_hold",
      "value": "Escape",
      "seconds": 0.6
    },
    {
      "type": "wait_log",
      "pattern": "VilverinContinue potion stock=0",
      "timeout_seconds": 25,
      "abort_on_failure": true
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "screenshot",
      "name": "fixed-view-after-potion.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key_down",
      "value": "F5"
    },
    {
      "type": "wait_log",
      "pattern": "Writing saved game",
      "timeout_seconds": 30,
      "after_start": true,
      "abort_on_failure": true
    },
    {
      "type": "key_up",
      "value": "F5"
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "wait_log",
      "path": "events.jsonl",
      "pattern": "\"event\"\\s*:\\s*\"save-complete\"",
      "timeout_seconds": 180,
      "abort_on_failure": true
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 600,
  "expected_exit": 0,
  "expected_log": [
    "VilverinContinue potion stock=1",
    "Writing saved game",
    "M16 potion Light applied: potion=content:oblivion.esm:09847f",
    "VilverinContinue potion stock=0"
  ],
  "forbidden_log": [
    "AddressSanitizer",
    "runtime error:",
    "Player died during original potion inventory survey",
    "M16 potion Light expired"
  ],
  "reviewed_error_log": [
    "Failed to create audio decoder, can not play audio stream",
    "Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found",
    "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead",
    "Failed to load 'meshes/landscape/miscbutterfly02\\.nif': Unsupported NiPathInterpolator banking or flip-avoidance flags, using marker_error instead"
  ],
  "environment": {
    "OPENMW_OBSCRIPT_EVENTS": "{output}/test-data/events.txt",
    "OPENMW_OBLIVION_AI_EVENTS": "{output}/ai-events.jsonl",
    "OPENMW_M15_EVENTS": "{output}/events.jsonl",
    "OPENMW_M15_RUN_ID": "earned-potion-light-use",
    "OPENMW_M15_EPOCH": "1"
  },
  "sdl_input_timeout_seconds": 60,
  "virtual_gamepad": false
}
