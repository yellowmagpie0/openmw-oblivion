{
  "schema_version": 1,
  "name": "oblivion-m10-audio-and-real-scripts",
  "cwd": "{source}",
  "environment": {
    "ALSOFT_DRIVERS": "wave",
    "ALSOFT_CONF": "{output}/config/alsoft.conf",
    "OPENMW_OBSCRIPT_EVENTS": "{source}/scripts/data/oblivion_compat/m10_runtime_events.txt",
    "OPENMW_OBSCRIPT_REPORT": "{output}/obscript-report.json"
  },
  "files": [
    {
      "path": "config/alsoft.conf",
      "content": "[wave]\nfile = {output}/m10-runtime.wav\n"
    },
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\ncontent=Knights.esp\nstart=ImperialDungeon01::ref=0x1fc41::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n[Sound]\nmaster volume = 1.0\nmusic volume = 0.4\nsfx volume = 1.0\nvoice volume = 1.0\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 31},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "real-quest-audio-weather.png", "minimum_entropy": 0.04},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 9},
    {"type": "assert_file", "path_glob": "m10-runtime.wav", "expected_count": 1, "minimum_size": 100000},
    {"type": "assert_file", "path_glob": "obscript-report.json", "expected_count": 1, "minimum_size": 1000},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["WTHR", "CWTH"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 15,
  "expected_exit": 0,
  "expected_log": ["Opened \"Wave File Writer\"", "M10 native voice index:", "M10 native music state music/dungeon:", "M10 voice playback: sound/voice/oblivion.esm/", "M7 ObScript: sayto topic=content:oblivion.esm:", "M7 ObScript: say topic=content:oblivion.esm:", "M7 ObScript: playsound sound=content:oblivion.esm:.*played=true", "M7 ObScript: playsound3d sound=content:oblivion.esm:.*played=true", "M10 weather forced: Clear override=false", "M7 ObScript: releaseweatheroverride", "Writing saved game 'Quicksave'"],
  "forbidden_log": ["M7 ObScript: deferred command=(say|sayto|playsound|playsound3d|forceweather|releaseweatheroverride)", "voice=missing", "Failed to (inspect|open) audio", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
