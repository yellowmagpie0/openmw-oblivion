{
  "schema_version": 1,
  "name": "Eastern cavern approach and war axe fight",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local approach=(function()\nlocal self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal Actor=require('openmw.types').Actor\nlocal nearby=require('openmw.nearby')\nlocal points={{util.vector3(4589.099609375,2871.93701171875,-466.0),util.vector3(4726.0966796875,3079.67236328125,-438.0),util.vector3(4886.2744140625,3213.18505859375,-448.0),util.vector3(5059.7392578125,3198.7919921875,-448.0),util.vector3(5205.134765625,3225.789306640625,-458.0),util.vector3(5342.73828125,3235.77978515625,-452.0),util.vector3(5482.267578125,3254.277587890625,-462.0)}}\nlocal step=1\nlocal ready=false\nlocal frames=0\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n frames=frames+1\n assert(Actor.stats.dynamic.health(self).current>0,'Player died during cavern traversal')\n if frames>=5 and not ready then\n  local c,g=false,false\n  for _,item in pairs(Actor.getEquipment(self)) do\n   if item.recordId==core.getFormId('Oblivion.esm',0x661c1) then c=true end\n   if item.recordId==core.getFormId('Oblivion.esm',0x661c3) then g=true end\n  end\n  assert(c and g,'Both armor pieces required') ready=true print('Substructure corridor ready')\n end\n if math.abs(camera.getPitch())<.025 then print('Substructure camera level') end\n if step<=#points then\n  local d=points[step]-self.position\n  local distance=math.sqrt(d.x*d.x+d.y*d.y)\n  if distance<25 then print('Substructure waypoint '..step..' reached') step=step+1\n  else\n   local f=self.rotation:apply(util.vector3(0,1,0))\n   local angle=math.atan2(f.y*d.x-f.x*d.y,f.x*d.x+f.y*d.y)\n   if math.abs(angle)<.04 then print('Substructure waypoint '..step..' facing') end\n   local x=math.max(-8192,math.min(8192,math.floor(angle*5120+.5)))\n   local y=math.floor(-camera.getPitch()*5120+.5)\n   print(string.format('Substructure waypoint %d aim x=%d y=%d',step,x,y))\n  end\n end\n timer=timer+dt\n if timer>1 then timer=0\n  print('Substructure corridor Player '..tostring(self.position)..' health='..Actor.stats.dynamic.health(self).current..' pitch='..camera.getPitch())\n  for _,id in ipairs({{0x3b526,0x3b513,0x3b543,0x3b518,0x3b51a,0x3b52e}}) do\n   local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n   if obj and obj:isValid() then print('Substructure encounter '..id..' pos='..tostring(obj.position)..' dead='..tostring(Actor.isDead(obj))..' health='..Actor.stats.dynamic.health(obj).current) end\n  end\n end\nend}}}}\n\nend)()\nlocal fight=(function()\nlocal self=require('openmw.self')\nlocal Actor=require('openmw.types').Actor\nlocal core=require('openmw.core')\nlocal nearby=require('openmw.nearby')\nlocal util=require('openmw.util')\nlocal frames=0\nlocal strike=0\nlocal wasUse=false\nlocal released=nil\nlocal done=false\nlocal selected=nil\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n frames=frames+1\n assert(Actor.stats.dynamic.health(self).current>0,'Player died in western rat fight')\n if frames==5 then print('Eastern goblin fight ready') end\n local target=nil\n local distance=math.huge\n local dead=0\n for _,id in ipairs({{0x3b52f}}) do\n  local rat=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n  assert(rat and rat:isValid(),'Eastern goblin missing')\n  if Actor.isDead(rat) then dead=dead+1\n  else\n   local d=(rat.position-self.position):length()\n   if d<distance then target=rat distance=d end\n  end\n end\n if distance<170 then print('Eastern goblin close approach') end\n if selected and selected:isValid() and not Actor.isDead(selected) then\n  target=selected distance=(target.position-self.position):length()\n else selected=target end\n local x=0\n if target then\n  local d=target.position-self.position\n  local f=self.rotation:apply(util.vector3(0,1,0))\n  local angle=math.atan2(f.y*d.x-f.x*d.y,f.x*d.x+f.y*d.y)\n  x=math.max(-8192,math.min(8192,math.floor(angle*5120+.5)))\n end\n print(string.format('Eastern goblin aim x=%d y=0 distance=%.2f',x,distance))\n if not done and dead==1 then done=true print('Eastern goblins defeated') end\n local use=self.controls.use~=0\n if use and not wasUse then strike=strike+1 released=nil print('Eastern strike '..strike..' armed') end\n if wasUse and not use then released=core.getSimulationTime() end\n if released and core.getSimulationTime()-released>=1 then print('Eastern strike '..strike..' settled') end\n wasUse=use\n timer=timer+dt\n if timer>=1 then timer=0 print('Eastern goblin fight health='..Actor.stats.dynamic.health(self).current..' remaining='..(1-dead)) end\nend}}}}\n\nend)()\nreturn {{engineHandlers={{onFrame=function(dt) approach.engineHandlers.onFrame(dt) fight.engineHandlers.onFrame(dt) end}}}}\n"
    }
  ],
