{
  "schema_version": 1,
  "name": "tutorial normal-input path around landing to first ambush room",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:01fc44 GetOpenState\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self = require('openmw.self')\nlocal step=1\nlocal last=''\nlocal tests={{function(p) return p.x<=630 end,function(p) return p.y>=1370 end,function(p) return p.x>=1370 end,function(p) return p.y>=1660 end,function(p) return p.x<=60 end,function(p) return p.y>=2110 end}}\nreturn {{engineHandlers={{onFrame=function()\n local p=self.position\n local band=tostring(math.floor(p.x/100)) .. ':' .. tostring(math.floor(p.y/100))\n if band~=last then last=band; print('Tutorial approach position: x=' .. tostring(p.x) .. ' y=' .. tostring(p.y) .. ' z=' .. tostring(p.z)) end\n if tests[step] and tests[step](p) then print('Tutorial approach waypoint ' .. tostring(step)); step=step+1 end\nend}}}}\n"
    }
  ],
  "m14": {
    "event_file": "ai-events.jsonl",
    "fixed_seed": 1414,
    "required_events": []
  },
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {
      "type": "wait_log",
      "pattern": "Applied TES4 runtime state:",
      "timeout_seconds": 90,
      "abort_on_failure": true
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "wait_log",
      "pattern": "acceptance-command actor=content:oblivion.esm:01fc44 name=GetOpenState result=3(?:\\s|$)",
      "timeout_seconds": 30,
      "abort_on_failure": true
    },
    {
      "type": "gamepad_axis",
      "axis": "left_x",
      "value": -1
    },
    {
      "type": "wait_log",
      "pattern": "Tutorial approach waypoint 1(?:\\s|$)",
      "timeout_seconds": 450,
      "abort_on_failure": true
    },
    {
      "type": "gamepad_axis",
      "axis": "left_x",
      "value": 0
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": -1
    },
    {
      "type": "wait_log",
      "pattern": "Tutorial approach waypoint 2(?:\\s|$)",
      "timeout_seconds": 450,
      "abort_on_failure": true
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": 0
    },
    {
      "type": "gamepad_axis",
      "axis": "left_x",
      "value": 1
    },
    {
      "type": "wait_log",
      "pattern": "Tutorial approach waypoint 3(?:\\s|$)",
      "timeout_seconds": 450,
      "abort_on_failure": true
    },
    {
      "type": "gamepad_axis",
      "axis": "left_x",
      "value": 0
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": -1
    },
    {
      "type": "wait_log",
      "pattern": "Tutorial approach waypoint 4(?:\\s|$)",
      "timeout_seconds": 450,
      "abort_on_failure": true
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": 0
    },
    {
      "type": "gamepad_axis",
      "axis": "left_x",
      "value": -1
    },
    {
      "type": "wait_log",
      "pattern": "Tutorial approach waypoint 5(?:\\s|$)",
      "timeout_seconds": 450,
      "abort_on_failure": true
    },
    {
      "type": "gamepad_axis",
      "axis": "left_x",
      "value": 0
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": -1
    },
    {
      "type": "wait_log",
      "pattern": "Tutorial approach waypoint 6(?:\\s|$)",
      "timeout_seconds": 450,
      "abort_on_failure": true
    },
    {
      "type": "gamepad_axis",
      "axis": "left_y",
      "value": 0
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "screenshot",
      "name": "ambush-approach.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key",
      "value": "F5"
    },
    {
      "type": "sleep",
      "seconds": 5
    },
    {
      "type": "m14_checkpoint",
      "name": "ambush-approach",
      "save_name": "Quicksave",
      "minimum_actor_count": 3000
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 2800,
  "expected_exit": 0,
  "expected_log": [
    "Applied TES4 runtime state:",
    "Tutorial approach waypoint 6"
  ],
  "forbidden_log": [
    "Unsupported ObScript command",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted",
    "TES4 AI update failed"
  ],
  "reviewed_error_log": [
    "Failed to create audio decoder, can not play audio stream",
    "Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found",
    "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead"
  ],
  "virtual_gamepad": true,
  "environment": {
    "OPENMW_OBSCRIPT_EVENTS": "{output}/test-data/events.txt",
    "OPENMW_OBSCRIPT_REPORT": "{output}/script-report.json"
  }
}
