{
  "schema_version": 1,
  "name": "morrowind-m10-weather-audio-media-regression",
  "cwd": "{source}",
  "environment": {
    "ALSOFT_DRIVERS": "wave",
    "ALSOFT_CONF": "{output}/config/alsoft.conf"
  },
  "files": [
    {
      "path": "config/alsoft.conf",
      "content": "[wave]\nfile = {output}/morrowind-runtime.wav\n"
    },
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{resources}/vfs-mw\"\ndata=\"{morrowind_data}\"\nfallback-archive=Morrowind.bsa\ncontent=Morrowind.esm\nstart=Balmora\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Sound]\nmaster volume = 1.0\nmusic volume = 0.5\nsfx volume = 1.0\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 22},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "morrowind-audio.png", "minimum_entropy": 0.04},
    {"type": "key_held", "value": "grave"},
    {"type": "type", "value": "ChangeWeather \"West Gash Region\" 1", "delay_ms": 1},
    {"type": "key_held", "value": "Return"},
    {"type": "key_held", "value": "grave"},
    {"type": "sleep", "seconds": 5},
    {"type": "screenshot", "name": "morrowind-weather-audio.png", "minimum_entropy": 0.04},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 5},
    {"type": "assert_file", "path_glob": "morrowind-runtime.wav", "expected_count": 1, "minimum_size": 100000},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "forbidden_ascii": ["GPRO", "T4VR", "T4ST", "OMW4STATE"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 15,
  "expected_exit": 0,
  "expected_log": ["Loading content file Morrowind.esm", "Selected game profile: morrowind", "Opened \"Wave File Writer\"", "Starting a new game", "Loading cell Balmora", "Writing saved game 'Quicksave'", "'Quicksave' is saved"],
  "forbidden_log": ["Selected game profile: oblivion", "Installed Oblivion profile services", "M10 native", "M10 weather", "M10 regional ambient", "M10 video playback: video[\\\\/](?:map loop|CreditsMenu|OblivionIntro)\\.bik", "Failed to start new game", "Failed to save game", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
