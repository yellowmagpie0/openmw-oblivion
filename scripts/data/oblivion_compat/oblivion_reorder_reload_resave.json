{
  "schema_version": 1,
  "name": "oblivion-plugin-reorder-reload-resave",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\ncontent=DLCMehrunesRazor.esp\ncontent=Knights.esp\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 800\nresolution y = 600\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--load-savegame={savegame}", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 800,
  "height": 600,
  "actions": [
    {"type": "sleep", "seconds": 25},
    {"type": "screenshot", "name": "plugin-reorder-after-load.png"},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 10},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST", "OMW4STATE"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 10,
  "expected_exit": 0,
  "expected_log": ["Loading content file DLCMehrunesRazor.esp", "Loading content file Knights.esp", "Applied TES4 runtime state:", "Writing saved game 'Quicksave'"],
  "forbidden_log": ["Failed to load saved game", "requires missing content", "fingerprint mismatch", "Failed to save game", "Error in frame", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
