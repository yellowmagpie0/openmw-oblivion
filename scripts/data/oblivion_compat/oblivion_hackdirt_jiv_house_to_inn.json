    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal points={{{{-65559.1484375,61875.81640625,10026.0}},{{-65630.3203125,61980.81640625,9998.0}},{{-65820.5546875,61952.77734375,9940.0}},{{-65914.4609375,61990.26171875,9900.0}},{{-66037.03125,62177.265625,9860.0}},{{-66209.078125,62508.98046875,9824.0}},{{-66220.671875,62736.37109375,9826.0}},{{-66327.609375,62995.30078125,9812.0}},{{-66453.5625,63094.62109375,9800.0}},{{-66640.125,63127.8125,9798.0}},{{-66791.890625,63174.01171875,9794.0}},{{-66879.6875,63284.8828125,9792.0}},{{-66791.1015625,63377.08203125,9792.0}},{{-66810.1796875,63572.9140625,9792.0}},{{-66833.9296875,63766.46875,9792.0}},{{-66899.2265625,63881.625,9792.0}},{{-67046.40625,64076.7421875,9792.0}},{{-67236.4765625,64290.3125,9790.0}},{{-67435.53125,64398.46875,9810.0}}}}\nlocal index=1\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n timer=timer+dt;if timer<0.1 then return end;timer=0\n local tag,target,object\n if not self.cell.isExterior then\n  if self.cell.name=='HackdirtMoslinsInn' then print('InnRoute entered='..self.cell.name);return end\n  tag='exit';object=0x28102\n else\n  print('InnRoute exterior=true')\n  if index<=#points then\n   tag=tostring(index);local p=points[index];target=util.vector3(p[1],p[2],p[3]);local v=target-self.position\n   if math.sqrt(v.x*v.x+v.y*v.y)<20 then print('InnRoute reached='..tag);index=index+1;return end\n  else tag='door';object=0x280e0 end\n end\n if object then\n  local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',object));if not obj or not obj:isValid() then print('InnRoute absent='..tag);return end\n  target=obj.position+util.vector3(0,0,30)\n end\n local v=target-self.position\n if tag=='exit' and math.sqrt(v.x*v.x+v.y*v.y)<110 then print('InnRoute near=exit') end\n local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n local pitch=0\n if object then local c=target-camera.getPosition();pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y)) end\n if math.abs(angle)<0.06 and math.abs(pitch-camera.getPitch())<0.04 then print('InnRoute ready='..tag) end\n print(string.format('InnRoute aim x=%d y=%d tag=%s pos=%.2f,%.2f,%.2f distance=%.2f',math.max(-150,math.min(150,math.floor(angle*128+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*128+.5))),tag,self.position.x,self.position.y,self.position.z,v:length()))\nend}}}}\n"
    }
