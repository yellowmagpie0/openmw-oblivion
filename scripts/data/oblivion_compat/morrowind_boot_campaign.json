{
  "schema_version": 1,
  "name": "morrowind-visual-boot-save-load",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{resources}/vfs-mw\"\ndata=\"{morrowind_data}\"\nfallback-archive=Morrowind.bsa\ncontent=Morrowind.esm\nstart=Balmora\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab"
  ],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 20},
    {"type": "screenshot", "name": "morrowind-boot.png"},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 5},
    {
      "type": "assert_file",
      "path_glob": "userdata/saves/*/*.omwsave",
      "expected_count": 1,
      "minimum_size": 1024,
      "forbidden_ascii": ["GPRO", "T4VR", "T4ST", "OMW4STATE"]
    },
    {"type": "key", "value": "F9"},
    {"type": "sleep", "seconds": 15},
    {"type": "screenshot", "name": "morrowind-after-load.png"}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 10,
  "expected_exit": 0,
  "expected_log": [
    "Loading content file Morrowind.esm",
    "Selected game profile: morrowind",
    "Starting a new game",
    "Loading cell Balmora",
    "Writing saved game 'Quicksave'",
    "'Quicksave' is saved",
    "Loading saved game 'Quicksave'"
  ],
  "forbidden_log": [
    "Selected game profile: oblivion",
    "Registered .* default oblivion archives",
    "Installed Oblivion profile services",
    "Failed to start new game",
    "Failed to save game",
    "Failed to load saved game",
    "Saved game profile .*cannot be loaded",
    "Error in frame",
    "onFrame failed",
    "Can't start .*scripts/omw",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted"
  ]
}
