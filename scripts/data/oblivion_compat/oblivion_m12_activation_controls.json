{
  "schema_version": 1,
  "name": "oblivion-m12-keyboard-and-gamepad-activation-reach",
  "cwd": "{source}",
  "files": [
    {"path": "config/openmw.cfg", "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01::ref=0x159857\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"},
    {"path": "config/settings.cfg", "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Input]\ncamera sensitivity = 0.1\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n"}
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "virtual_gamepad": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 20},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key_hold", "value": "KP_2", "seconds": 3.2},
    {"type": "screenshot", "name": "locked-container-in-reach.png", "minimum_entropy": 0.03},
    {"type": "key", "value": "space"},
    {"type": "sleep", "seconds": 1},
    {"type": "gamepad_button", "value": "a"},
    {"type": "sleep", "seconds": 1}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 35,
  "expected_exit": 0,
  "expected_log": [
    "M12 player stats:",
    "M5 activation focus: result=object.*tooltip=true input=keyboard-mouse",
    "M5 activation focus: result=object.*tooltip=true input=gamepad",
    "M5 interaction: kind=loot result=locked"
  ],
  "forbidden_log": ["Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
