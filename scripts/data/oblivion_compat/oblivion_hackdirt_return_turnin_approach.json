{
  "schema_version": 1,
  "name": "Hackdirt original return: ordinary shop stairs and Seed-Neeus approach",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ChorrolNorthernGoodsAndTrade::ref=0x0280fa::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=hackdirt-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:027815 GetStage\n"
    },
    {
      "path": "test-data/hackdirt-observer.omwscripts",
      "content": "PLAYER: hackdirt-observer.lua\n"
    },
    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal Actor=require('openmw.types').Actor\nlocal points={{{{400,-125,-223}},{{5,-125,2}},{{5,-36,1}},{{-73,-36,1}},{{-150,-36,1}}}}\nlocal index=1\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n timer=timer+dt;if timer<0.1 then return end;timer=0\n assert(not Actor.isDead(self),'Player died during return turn-in')\n local darma=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x280fa))\n assert(darma and darma:isValid() and not Actor.isDead(darma),'Living Dar-Ma missing at turn-in')\n print('ReturnTurnin darmaCell='..darma.cell.name..' health='..Actor.stats.dynamic.health(darma).current)\n if core.isWorldPaused() then print('ReturnTurnin paused');return end\n local target,tag\n if index<=#points then\n  local p=points[index];target=util.vector3(p[1],p[2],p[3]);tag=tostring(index)\n  local v=target-self.position;if math.sqrt(v.x*v.x+v.y*v.y)<12 then print('ReturnTurnin reached='..tag);index=index+1;return end\n else\n  local mother=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x234fd));assert(mother and mother:isValid(),'Seed-Neeus missing');target=mother.position+util.vector3(0,0,85);tag='mother'\n end\n local v=target-self.position;local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n local pitch=0;if tag=='mother' then local c=target-camera.getPosition();pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y)) end\n if math.abs(angle)<0.035 and math.abs(pitch-camera.getPitch())<0.03 then print('ReturnTurnin ready='..tag) end\n print(string.format('ReturnTurnin aim x=%d y=%d pos=%.2f,%.2f,%.2f distance=%.2f',math.max(-150,math.min(150,math.floor(angle*256+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*256+.5))),self.position.x,self.position.y,self.position.z,v:length()))\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
