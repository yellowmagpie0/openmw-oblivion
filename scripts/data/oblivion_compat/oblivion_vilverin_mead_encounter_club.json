{
  "schema_version": 1,
  "name": "Defeat the actual Vilverin Mead-room bandits using the carried healthy club",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command dynamic:player:0000000000000001 GetAV Health\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal camera=require('openmw.camera')\nlocal util=require('openmw.util')\nlocal nearby=require('openmw.nearby')\nlocal t=0\nreturn {{engineHandlers={{onFrame=function(dt)\n t=t+dt;if t<.2 then return end;t=0\n local target=util.vector3(-4984,-4339,-1285)\n for _,a in ipairs(nearby.actors) do\n  if a.id~=self.id and not Actor.isDead(a) then print('MeadFight actor='..a.id..' base='..a.recordId..' pos='..tostring(a.position)..' health='..Actor.stats.dynamic.health(a).current) end\n end\n local b=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x6c362))\n if b and b:isValid() then print('MeadFight bottle pos='..tostring(b.position)..' bbox='..tostring(b:getBoundingBox().center)) end\n local enemy=nil;local distance=math.huge\n for _,id in ipairs({{0x4bb72,0x4bb73,0x6bfba}}) do\n  local a=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n  if a and a:isValid() and not Actor.isDead(a) then local dist=(a.position-self.position):length();if dist<distance then enemy=a;distance=dist end end\n end\n if enemy then\n  local aim=enemy:getBoundingBox().center;local v=aim-self.position\n  local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n  local c=aim-camera.getPosition();local pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y))\n  print(string.format('MeadFight look x=%d y=%d health=%.3f distance=%.2f',math.max(-150,math.min(150,math.floor(angle*256+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*256+.5))),Actor.stats.dynamic.health(enemy).current,distance))\n else print('MeadFight victory');print('MeadFight look x=0 y=0 health=0 distance=0') end\n for _,item in pairs(Actor.getEquipment(self)) do if item.recordId==core.getFormId('Oblivion.esm',0x159829) then print('MeadFight club equipped') end end\n local p=camera.getViewTransform():apply(target)\n local a=math.atan2(p.x,-p.z)\n local e=-math.atan2(p.y,math.sqrt(p.x*p.x+p.z*p.z))\n print(string.format('VilverinTrap aim x=%d y=%d',math.max(-150,math.min(150,math.floor(a*256+.5))),math.max(-100,math.min(100,math.floor(e*256+.5)))))\n print('VilverinTrap sample pos='..tostring(self.position)..' health='..Actor.stats.dynamic.health(self).current..' dead='..tostring(Actor.isDead(self))..' paused='..tostring(core.isWorldPaused()))\n if self.position.y < -3300 then print('VilverinTrap beyond wire') end\n for _,id in ipairs({{0x6c362,0x6c363,0x6c364}}) do\n  local o=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n  if o and o:isValid() then print('VilverinTrap original '..id..' pos='..tostring(o.position)) end\n end\nend}}}}\n"
    }
  ],
