scn M15ScriptEquipmentOpponent
short fighting
Begin OnActivate
    if fighting == 0
        StartCombat Player
        set fighting to 1
    elseif fighting == 2
        UnequipItem WeapIronShortswordRusty
        set fighting to 3
    elseif fighting == 3
        EquipItem WeapIronShortswordRusty
        set fighting to 4
    endif
End
Begin GameMode
    if fighting == 1
        if GetAV Fatigue < GetBaseAV Fatigue
            SetRestrained 1
            set fighting to 2
        endif
    endif
End
