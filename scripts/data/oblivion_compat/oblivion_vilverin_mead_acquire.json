{
  "schema_version": 1,
  "name": "Collect an original Mead bottle from the actual Vilverin lower-room table",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command dynamic:player:0000000000000001 GetAV Health\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal camera=require('openmw.camera')\nlocal util=require('openmw.util')\nlocal nearby=require('openmw.nearby')\nlocal t=0\nreturn {{engineHandlers={{onFrame=function(dt)\n t=t+dt;if t<.2 then return end;t=0\n local target=util.vector3(-4984,-3924,-1300)\n if self.position.x > -5050 then\n  local bottle=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x6c362))\n  target=(bottle and bottle:isValid()) and bottle:getBoundingBox().center or util.vector3(-4984,-4339,-1325)\n end\n print('MeadAcquire stock='..Actor.inventory(self):countOf(core.getFormId('Oblivion.esm',0xb1201)))\n local p=camera.getViewTransform():apply(target)\n local a=math.atan2(p.x,-p.z)\n local e=-math.atan2(p.y,math.sqrt(p.x*p.x+p.z*p.z))\n print(string.format('VilverinTrap aim x=%d y=%d',math.max(-150,math.min(150,math.floor(a*256+.5))),math.max(-100,math.min(100,math.floor(e*256+.5)))))\n print('VilverinTrap sample pos='..tostring(self.position)..' health='..Actor.stats.dynamic.health(self).current..' dead='..tostring(Actor.isDead(self))..' paused='..tostring(core.isWorldPaused()))\n if self.position.y < -3300 then print('VilverinTrap beyond wire') end\n for _,id in ipairs({{0x6c362,0x6c363,0x6c364}}) do\n  local o=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n  if o and o:isValid() then print('VilverinTrap original '..id..' pos='..tostring(o.position)) end\n end\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 640,
  "height": 360,
