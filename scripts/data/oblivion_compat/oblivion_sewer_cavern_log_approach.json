{
  "schema_version": 1,
  "name": "Cavern trap passage to log encounter approach",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal Actor=require('openmw.types').Actor\nlocal nearby=require('openmw.nearby')\nlocal points={{util.vector3(737.581298828125,1629.49365234375,-210.0),util.vector3(926.6140747070312,1596.3486328125,-216.0),util.vector3(1155.23974609375,1530.0281982421875,-244.0),util.vector3(1400.98388671875,1546.8193359375,-278.0),util.vector3(1584.9156494140625,1545.891845703125,-292.0),util.vector3(1764.64453125,1636.10205078125,-292.0),util.vector3(1937.683837890625,1640.5780029296875,-292.0),util.vector3(2084.6103515625,1653.540771484375,-292.0),util.vector3(2311.430908203125,1658.0113525390625,-292.0),util.vector3(2556.18408203125,1635.3724365234375,-292.0),util.vector3(2851.225830078125,1642.61279296875,-292.0),util.vector3(2968.016845703125,1550.03466796875,-288.0),util.vector3(3125.84814453125,1469.7353515625,-292.0),util.vector3(3298.343017578125,1400.510498046875,-292.0),util.vector3(3516.74365234375,1412.8060302734375,-292.0)}}\nlocal step=1\nlocal ready=false\nlocal frames=0\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n frames=frames+1\n assert(Actor.stats.dynamic.health(self).current>0,'Player died during cavern traversal')\n if frames>=5 and not ready then\n  local c,g=false,false\n  for _,item in pairs(Actor.getEquipment(self)) do\n   if item.recordId==core.getFormId('Oblivion.esm',0x661c1) then c=true end\n   if item.recordId==core.getFormId('Oblivion.esm',0x661c3) then g=true end\n  end\n  assert(c and g,'Both armor pieces required') ready=true print('Substructure corridor ready')\n end\n if math.abs(camera.getPitch())<.025 then print('Substructure camera level') end\n if step<=#points then\n  local d=points[step]-self.position\n  local distance=math.sqrt(d.x*d.x+d.y*d.y)\n  if distance<25 then print('Substructure waypoint '..step..' reached') step=step+1\n  else\n   local f=self.rotation:apply(util.vector3(0,1,0))\n   local angle=math.atan2(f.y*d.x-f.x*d.y,f.x*d.x+f.y*d.y)\n   if math.abs(angle)<.04 then print('Substructure waypoint '..step..' facing') end\n   local x=math.max(-8192,math.min(8192,math.floor(angle*5120+.5)))\n   local y=math.floor(-camera.getPitch()*5120+.5)\n   print(string.format('Substructure waypoint %d aim x=%d y=%d',step,x,y))\n  end\n end\n timer=timer+dt\n if timer>1 then timer=0\n  print('Substructure corridor Player '..tostring(self.position)..' health='..Actor.stats.dynamic.health(self).current..' pitch='..camera.getPitch())\n  for _,id in ipairs({{0x3b526,0x3b513,0x3b543,0x3b518,0x3b51a,0x3b52e}}) do\n   local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',id))\n   if obj and obj:isValid() then print('Substructure encounter '..id..' pos='..tostring(obj.position)..' dead='..tostring(Actor.isDead(obj))..' health='..Actor.stats.dynamic.health(obj).current) end\n  end\n end\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
