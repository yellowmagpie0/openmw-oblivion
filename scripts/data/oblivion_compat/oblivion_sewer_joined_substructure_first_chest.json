{
  "schema_version": 1,
  "name": "Joined original Substructure first chest loot",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.05\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:02466e GetStage\nat 0 command dynamic:player:0000000000000001 GetDead\nat 0 command content:oblivion.esm:01760f GetOpenState\nat 0 command content:oblivion.esm:01760f GetLocked\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal Actor=require('openmw.types').Actor\nlocal nearby=require('openmw.nearby')\nlocal input=require('openmw.input')\nlocal frame=0\nlocal sampleFrame=nil\nlocal held=false\nlocal function aim(p)\n local t=camera.getViewTransform():inverse()\n local origin=t:apply(util.vector3(0,0,0))\n local f=t:apply(util.vector3(0,0,-1))-origin\n local d=p-origin\n local yaw=math.atan2(f.y*d.x-f.x*d.y,f.x*d.x+f.y*d.y)\n local pitch=math.atan2(f.z,math.sqrt(f.x*f.x+f.y*f.y))-math.atan2(d.z,math.sqrt(d.x*d.x+d.y*d.y))\n local gain=camera.getMode()==camera.MODE.FirstPerson and 1 or 2\n local function units(a) return math.max(-8192,math.min(8192,math.floor(a*5120+.5))) end\n return units(yaw*gain),units(pitch),math.abs(yaw)<.04 and math.abs(pitch)<.04\nend\nlocal ready,facing,close,looted=false,false,false,false\nlocal expected=nil\nreturn {{engineHandlers={{onFrame=function()\n frame=frame+1\n local down=input.isKeyPressed(input.KEY.F7)\n if down and not held then sampleFrame=frame+3 end\n if not down then sampleFrame=nil end\n held=down\n if sampleFrame and frame>=sampleFrame then print(\"Substructure camera settled\") end\n assert(not Actor.isDead(self),\"Player died on chest course\")\n local chest=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x49352))\n if not chest or not chest:isValid() then return end\n local inv=Actor.inventory(self)\n if not ready then\n  expected={{}}\n  for _,entry in ipairs({{{{0x90613,1}},{{0xa,5}},{{0x47aca,1}},{{0x17829,24}},{{0x2cf9f,3}},{{0x661c1,1}},{{0x661c3,1}},{{0x9310,1}}}}) do\n   local id=core.getFormId('Oblivion.esm',entry[1]) expected[id]=inv:countOf(id)+entry[2]\n  end\n  ready=true print('Substructure chest approach ready')\n end\n local delta=chest.position-self.position\n local x,y,f=aim(util.vector3(chest.position.x,chest.position.y,self.position.z+100))\n print(string.format('Substructure chest route aim x=%d y=%d',x,y))\n if f then print('Substructure chest route facing') end\n if math.sqrt(delta.x*delta.x+delta.y*delta.y)<90 then print('Substructure chest in range '..tostring(self.position)) end\n local ax,ay,af=aim(chest:getBoundingBox().center)\n print(string.format('Substructure chest focus aim x=%d y=%d',ax,ay))\n if af then print('Substructure chest focused') end\n if not looted then\n  local all=true for id,count in pairs(expected) do if inv:countOf(id)~=count then all=false end end\n  if all then looted=true print('Substructure chest loot transferred eight item types') end\n end\nend}}}}\n"
    }
  ],
  "command": [
