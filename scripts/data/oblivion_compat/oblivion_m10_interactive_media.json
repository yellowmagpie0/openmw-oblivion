{
  "schema_version": 1,
  "name": "oblivion-m10-interactive-credits-and-new-game-intro",
  "cwd": "{source}",
  "environment": {"ALSOFT_DRIVERS": "null"},
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=0\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 4},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key", "value": "Escape"},
    {"type": "sleep", "seconds": 2},
    {"type": "key", "value": "Escape"},
    {"type": "sleep", "seconds": 2},
    {"type": "key", "value": "Escape"},
    {"type": "sleep", "seconds": 2},
    {"type": "key", "value": "Escape"},
    {"type": "sleep", "seconds": 2},
    {"type": "key", "value": "Escape"},
    {"type": "sleep", "seconds": 5},
    {"type": "screenshot", "name": "interactive-menu.png", "minimum_entropy": 0.04},
    {"type": "mouse_move_absolute", "x": 640, "y": 648},
    {"type": "mouse_click", "button": 1},
    {"type": "sleep", "seconds": 4},
    {"type": "screenshot", "name": "official-credits.png", "minimum_entropy": 0.01},
    {"type": "key", "value": "Escape"},
    {"type": "sleep", "seconds": 3},
    {"type": "mouse_move_absolute", "x": 640, "y": 576},
    {"type": "mouse_click", "button": 1},
    {"type": "sleep", "seconds": 5},
    {"type": "screenshot", "name": "official-new-game-intro.png", "minimum_entropy": 0.01}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 15,
  "expected_exit": 0,
  "expected_log": ["M10 video playback: video[\\\\/]CreditsMenu.bik", "Starting a new game", "M10 native new-game start: ImperialDungeon01", "M10 video playback: video[\\\\/]OblivionIntro.bik"],
  "forbidden_log": ["ImageButton: can't find image textures[\\\\/]menu_", "Failed to open video", "Could not open video", "Failed to open image: Resource 'textures[\\\\/](?:sky|water|weather|loading)[\\\\/]", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
