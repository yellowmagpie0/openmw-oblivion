scn M15StationaryOpponent
short fighting

Begin OnActivate
    if fighting == 1
        StopCombat
        set fighting to 2
    endif
    if fighting == 0
        StartCombat Player
        set fighting to 1
    endif
End

Begin GameMode
    if fighting == 1
        if GetAV Fatigue < 0
            StopCombat
            set fighting to 2
        endif
    endif
End
