{
  "schema_version": 1,
  "name": "native-ignore-friendly-hits-continuation",
  "cwd": "{source}",
  "environment": {
    "OPENMW_OBSCRIPT_EVENTS": "{output}/flag-events.txt",
    "OPENMW_OBSCRIPT_REPORT": "{output}/obscript-report.json",
    "OPENMW_M15_EVENTS": "{output}/m15-events.jsonl",
    "OPENMW_M15_RUN_ID": "native-ignore-friendly-hits-continuation",
    "OPENMW_M15_EPOCH": "2"
  },
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\ncontent=Knights.esp\nstart=ImperialDungeon01::ref=0x1fc41::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n[Sound]\nmaster volume = 1.0\nmusic volume = 0.4\nsfx volume = 1.0\nvoice volume = 1.0\n[General]\nscreenshot format = png\n[Physics]\noblivion fixed substep = 0.0167\noblivion update type = 0\noblivion chase delta mult = 0.05\n"
    },
    {
      "path": "flag-events.txt",
      "content": "at 3 command Player GetIgnoreFriendlyHits\nat 4 command content:oblivion.esm:032a15 GetIgnoreFriendlyHits\nat 5 command content:oblivion.esm:070f51 GetIgnoreFriendlyHits\nat 6 command Player SetIgnoreFriendlyHits -1\nat 7 command Player GetIgnoreFriendlyHits\nat 8 command content:oblivion.esm:070f51 SetIgnoreFriendlyHits -1\nat 9 command content:oblivion.esm:070f51 GetIgnoreFriendlyHits\nat 10 command content:oblivion.esm:032a15 SetIgnoreFriendlyHits -1\nat 11 command content:oblivion.esm:032a15 GetIgnoreFriendlyHits\nat 13 command Player GetPlayerInSEWorld\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-grab",
    "--no-sound=1",
    "--load-savegame={output}/userdata/saves/Bendu_Olo/Quicksave.omwsave"
  ],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {
      "type": "wait_log",
      "pattern": "Applied TES4 runtime state:",
      "timeout_seconds": 120
    },
    {
      "type": "wait_log",
      "pattern": "acceptance-command actor=dynamic:player:0000000000000001 name=GetPlayerInSEWorld result=0",
      "timeout_seconds": 180
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "screenshot",
      "name": "ignore-friendly-hits-continuation.png",
      "minimum_entropy": 0.02
    },
    {
      "type": "key",
      "value": "F5"
    },
    {
      "type": "wait_log",
      "pattern": "Writing saved game 'Quicksave'",
      "timeout_seconds": 30
    },
    {
      "type": "sleep",
      "seconds": 3
    },
    {
      "type": "assert_file",
      "path_glob": "userdata/saves/*/*.omwsave",
      "expected_count": 1,
      "minimum_size": 1024,
      "contains_ascii": [
        "T4ST",
        "OMW4STATE"
      ]
    },
    {
      "type": "assert_file",
      "path_glob": "obscript-report.json",
      "expected_count": 1,
      "minimum_size": 1000
    }
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 240,
  "expected_exit": 0,
  "expected_log": [
    "Writing saved game 'Quicksave'",
    "acceptance-command actor=dynamic:player:0000000000000001 name=GetPlayerInSEWorld result=0",
    "acceptance-command actor=dynamic:player:0000000000000001 name=GetIgnoreFriendlyHits result=1",
    "acceptance-command actor=content:oblivion.esm:032a15 name=GetIgnoreFriendlyHits result=0",
    "acceptance-command actor=content:oblivion.esm:070f51 name=GetIgnoreFriendlyHits result=1"
  ],
  "forbidden_log": [
    "Failed to (inspect|open) audio",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted",
    "Failed to load saved game",
    "Failed to save game",
    "Failed to start new game"
  ]
}
