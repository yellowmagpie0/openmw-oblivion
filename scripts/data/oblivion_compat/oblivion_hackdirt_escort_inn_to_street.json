{
  "schema_version": 1,
  "name": "Original rescued Dar-Ma and Player cross Moslin inn onto Hackdirt street",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ChorrolNorthernGoodsAndTrade::ref=0x0280fa::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=hackdirt-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 640\nresolution y = 360\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = true\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command content:oblivion.esm:027815 GetStage\n"
    },
    {
      "path": "test-data/hackdirt-observer.omwscripts",
      "content": "PLAYER: hackdirt-observer.lua\n"
    },
    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal Actor=require('openmw.types').Actor\nlocal timer=0\nlocal index=1\nlocal points={{{{199.0653839111328,481.31915283203125,0.0}},{{291.9553527832031,445.66168212890625,2.0}},{{389.0908203125,347.551513671875,0.0}},{{388.38067626953125,245.0630340576172,0.0}},{{398.50421142578125,145.97894287109375,0.0}},{{326.45343017578125,37.55244445800781,0.0}},{{246.689208984375,-2.606792688369751,0.0}},{{169.53721618652344,-51.46400451660156,0.0}},{{91.2643814086914,-97.06729888916016,2.0}},{{57.78220748901367,-172.15550231933594,2.0}},{{-2.8498008251190186,-236.7174072265625,2.0}},{{-133.1930694580078,-358.9654541015625,0.0}},{{-209.44088745117188,-467.9173278808594,0.0}}}}\nreturn {{engineHandlers={{onFrame=function(dt)\n timer=timer+dt;if timer<0.1 then return end;timer=0\n assert(not Actor.isDead(self),'Player died leaving inn')\n local a=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x280fa))\n if a and a:isValid() then assert(not Actor.isDead(a),'Dar-Ma died leaving inn');print('EscortStreet darmaCell='..a.cell.name..' position='..tostring(a.position)..' health='..Actor.stats.dynamic.health(a).current) end\n if core.isWorldPaused() then print('EscortStreet paused');return end\n print('EscortStreet playerCell='..self.cell.name..' position='..tostring(self.position))\n if self.cell.isExterior then\n  print('EscortStreet playerExterior')\n  if a and a:isValid() and a.cell.isExterior and (a.position-self.position):length()<450 then print('EscortStreet followerExterior') end\n  return\n end\n local tag,target\n if index<=#points then\n  tag=tostring(index);local p=points[index];target=util.vector3(p[1],p[2],p[3]);local v=target-self.position\n  if math.sqrt(v.x*v.x+v.y*v.y)<20 then print('EscortStreet reached='..tag);index=index+1;return end\n else\n  tag='door';local door=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',0x280fe));assert(door and door:isValid(),'Original inn exit missing');target=door.position+util.vector3(0,0,30)\n end\n local v=target-self.position;local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y);local pitch=0\n if tag=='door' then local c=target-camera.getPosition();pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y)) end\n if math.abs(angle)<0.05 and math.abs(pitch-camera.getPitch())<0.04 then print('EscortStreet ready='..tag) end\n print(string.format('EscortStreet aim x=%d y=%d',math.max(-150,math.min(150,math.floor(angle*128+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*128+.5)))))\nend}}}}\n"
    }
  ],
