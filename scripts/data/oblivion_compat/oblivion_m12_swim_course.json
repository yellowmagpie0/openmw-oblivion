{
  "schema_version": 1,
  "name": "oblivion-m12-waterfront-swim-course",
  "cwd": "{source}",
  "files": [
    {"path": "config/openmw.cfg", "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=OldBridgeExterior::ref=0x60423::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"},
    {"path": "config/settings.cfg", "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n"}
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 22},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key_down", "value": "s"},
    {"type": "sleep", "seconds": 5},
    {"type": "key_up", "value": "s"},
    {"type": "screenshot", "name": "waterfront-swimming.png", "minimum_entropy": 0.04},
    {"type": "key_down", "value": "F5"},
    {"type": "sleep", "seconds": 0.1},
    {"type": "key_up", "value": "F5"},
    {"type": "sleep", "seconds": 5},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 45,
  "expected_exit": 0,
  "expected_log": ["M12 player stats:", "M12 exterior start target: cell=OldBridgeExterior ref=0x60423", "M11 animation loaded: ref=\"Player\" group=swim", "Writing saved game 'Quicksave'"],
  "forbidden_log": ["Failed to start new game", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
