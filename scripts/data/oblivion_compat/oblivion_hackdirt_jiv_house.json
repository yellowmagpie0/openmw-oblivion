      "content": "PLAYER: hackdirt-observer.lua\n"
    },
    {
      "path": "test-data/hackdirt-observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal util=require('openmw.util')\nlocal camera=require('openmw.camera')\nlocal nearby=require('openmw.nearby')\nlocal points={{{{-67324.34375,62132.953125,9858.0}},{{-67121.7421875,62099.36328125,9862.0}},{{-67013.28125,62209.28125,9852.0}},{{-66768.78125,62206.36328125,9842.0}},{{-66483.3046875,62212.26171875,9828.0}},{{-66297.8359375,62082.96484375,9824.0}},{{-66164.7734375,62005.54296875,9830.0}},{{-66023.96875,61994.46484375,9870.0}},{{-65914.4609375,61990.26171875,9900.0}},{{-65820.5546875,61952.77734375,9940.0}},{{-65630.3203125,61980.81640625,9998.0}},{{-65559.1484375,61875.81640625,10026.0}},{{-65403,61804,10048}}}}\nlocal index=1\nlocal timer=0\nreturn {{engineHandlers={{onFrame=function(dt)\n timer=timer+dt;if timer<0.1 then return end;timer=0\n local tag,target,object\n if not self.cell.isExterior then\n  if self.cell.name=='HackdirtJivHirielsHouse' then print('JivHouse entered='..self.cell.name);return end\n  tag='exit';object=0x280f9\n else\n  print('JivHouse exterior=true')\n  if index<=#points then\n   tag=tostring(index);local p=points[index];target=util.vector3(p[1],p[2],p[3]);local v=target-self.position\n   if math.sqrt(v.x*v.x+v.y*v.y)<20 then print('JivHouse reached='..tag);index=index+1;return end\n  else tag='door';object=0x280db end\n end\n if object then\n  local obj=nearby.getObjectByFormId(core.getFormId('Oblivion.esm',object));if not obj or not obj:isValid() then print('JivHouse absent='..tag);return end\n  target=obj.position+util.vector3(0,0,30)\n end\n local v=target-self.position\n if tag=='exit' and math.sqrt(v.x*v.x+v.y*v.y)<110 then print('JivHouse near=exit') end\n local f=self.rotation:apply(util.vector3(0,1,0));local angle=math.atan2(f.y*v.x-f.x*v.y,f.x*v.x+f.y*v.y)\n local pitch=0\n if object then local c=target-camera.getPosition();pitch=-math.atan2(c.z,math.sqrt(c.x*c.x+c.y*c.y)) end\n if math.abs(angle)<0.06 and math.abs(pitch-camera.getPitch())<0.04 then print('JivHouse ready='..tag) end\n print(string.format('JivHouse aim x=%d y=%d tag=%s pos=%.2f,%.2f,%.2f distance=%.2f',math.max(-150,math.min(150,math.floor(angle*512+.5))),math.max(-100,math.min(100,math.floor((pitch-camera.getPitch())*512+.5))),tag,self.position.x,self.position.y,self.position.z,v:length()))\nend}}}}\n"
    }
