{
  "schema_version": 1,
  "name": "oblivion-m7-native-script-runtime",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\ncontent=DLCShiveringIsles.esp\ncontent=DLCBattlehornCastle.esp\ncontent=DLCFrostcrag.esp\ncontent=DLCHorseArmor.esp\ncontent=DLCMehrunesRazor.esp\ncontent=DLCOrrery.esp\ncontent=DLCSpellTomes.esp\ncontent=DLCThievesDen.esp\ncontent=DLCVileLair.esp\ncontent=Knights.esp\nstart=ImperialDungeon01::ref=0x1fc41::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 22},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "screenshot", "name": "tutorial-wall-before.png"},
    {"type": "sleep", "seconds": 20},
    {"type": "screenshot", "name": "tutorial-wall-after.png"},
    {"type": "sleep", "seconds": 5},
    {"type": "screenshot", "name": "wide-script-matrix-complete.png"},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 7},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST"]}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 65,
  "expected_exit": 0,
  "expected_log": [
    "M7 ObScript runtime: compiled=11051 failed=0",
    "M7 ObScript: playgroup ref=content:oblivion.esm:01fc41 group=forward",
    "M7 ObScript: setstage quest=content:dlcbattlehorncastle.esp:00b089 stage=90",
    "M7 ObScript: acceptance-event command=dialogue",
    "M7 ObScript: acceptance-event command=effect",
    "M7 ObScript: acceptance-event command=activate",
    "Writing saved game 'Quicksave'"
  ],
  "forbidden_log": [
    "M7 ObScript diagnostic",
    "M5 interaction: kind=activate result=opened",
    "Error in frame",
    "onFrame failed",
    "Segmentation fault",
    "Assertion.*failed",
    "Aborted"
  ]
}
