{
  "schema_version": 1,
  "name": "original-oblivion-m5-prison-viewpoint",
  "cwd": "{oblivion_install}",
  "command": ["{proton}", "run", "{oblivion_exe}"],
  "environment": {
    "STEAM_COMPAT_DATA_PATH": "{original_prefix}",
    "STEAM_COMPAT_CLIENT_INSTALL_PATH": "{steam_root}",
    "STEAM_COMPAT_INSTALL_PATH": "{oblivion_install}",
    "STEAM_COMPAT_APP_ID": "22330",
    "SteamAppId": "22330",
    "SteamGameId": "22330",
    "PROTON_LOG_DIR": "{output}"
  },
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 60},
    {"type": "screenshot", "name": "original-main-menu.png", "minimum_entropy": 0.1, "minimum_mean": 0.1},
    {"type": "focus_window", "name": "Oblivion"},
    {"type": "mouse_move", "x": -210, "y": 133},
    {"type": "sleep", "seconds": 1},
    {"type": "screenshot", "name": "original-continue-selected.png", "minimum_entropy": 0.1},
    {"type": "focus_window", "name": "Oblivion"},
    {"type": "mouse_click"},
    {"type": "sleep", "seconds": 15},
    {"type": "screenshot", "name": "original-loaded-save.png", "minimum_entropy": 0.05},
    {"type": "focus_window", "name": "Oblivion"},
    {"type": "key", "value": "grave"},
    {"type": "type", "value": "coc ImperialDungeon01"},
    {"type": "key", "value": "Return"},
    {"type": "sleep", "seconds": 12},
    {"type": "type", "value": "player.setpos x 567.867"},
    {"type": "key", "value": "Return"},
    {"type": "type", "value": "player.setpos y -53.9168"},
    {"type": "key", "value": "Return"},
    {"type": "type", "value": "player.setpos z -101.598"},
    {"type": "key", "value": "Return"},
    {"type": "type", "value": "player.setangle z 76.158"},
    {"type": "key", "value": "Return"},
    {"type": "sleep", "seconds": 5},
    {"type": "key", "value": "grave"},
    {"type": "sleep", "seconds": 5},
    {"type": "screenshot", "name": "original-prison-start.png", "minimum_entropy": 0.01}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 20,
  "expected_exit": -15,
  "forbidden_log": ["Unhandled page fault", "Assertion.*failed"]
}
