{
  "schema_version": 1,
  "name": "oblivion-m12-keyboard-and-gamepad-jump-course",
  "cwd": "{source}",
  "files": [
    {"path": "config/openmw.cfg", "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01::ref=0x1fc41::side=south\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"},
    {"path": "config/settings.cfg", "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Models]\nload unsupported nif files = true\n[Shaders]\nforce shaders = true\n"}
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "xvfb": true,
  "virtual_gamepad": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 20},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "key_held", "value": "e"},
    {"type": "sleep", "seconds": 2},
    {"type": "gamepad_axis", "axis": "left_trigger", "value": 1},
    {"type": "sleep", "seconds": 0.2},
    {"type": "gamepad_axis", "axis": "left_trigger", "value": 0},
    {"type": "sleep", "seconds": 2},
    {"type": "screenshot", "name": "after-jumps.png", "minimum_entropy": 0.03}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 40,
  "expected_exit": 0,
  "expected_log": [
    "M12 input action: jump value=.*source=keyboard-mouse",
    "M12 player movement: mode=jump input=keyboard-mouse",
    "M12 input action: jump value=.*source=gamepad",
    "M12 player movement: mode=jump input=gamepad"
  ],
  "forbidden_log": ["Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"]
}
