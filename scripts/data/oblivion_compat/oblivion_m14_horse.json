{
  "schema_version": 1,
  "name": "oblivion-m14-horse-mount-dismount",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=4,16::ref=0x68451::side=east\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[Input]\ncamera sensitivity = 1.0\n[General]\nscreenshot format = png\n"
    }
  ],
  "command": ["{openmw}", "--replace=config", "--config", "{output}/config", "--no-sound=1", "--no-grab"],
  "m14": {
    "event_file": "ai-events.jsonl",
    "fixed_seed": 1417,
    "minimum_event_count": 100,
    "required_events": [
      {"event": "selection"},
      {"event": "phase"}
    ],
    "required_event_order": [
      {"event": "selection"},
      {"event": "phase"}
    ],
    "actor_event_requirements": [
      {
        "actor": "dynamic:player:0000000000000001",
        "required_event_order": [
          {"event": "horse-mount", "reason": "horse=content:oblivion.esm:068451"},
          {"event": "horse-dismount", "reason": "horse=content:oblivion.esm:068451"}
        ],
        "minimum_event_counts": {"horse-mount": 1, "horse-dismount": 1},
        "maximum_event_counts": {"horse-mount": 1, "horse-dismount": 1}
      },
      {
        "actor": "content:oblivion.esm:068451",
        "required_events": [
          {"event": "horse-rider", "reason": "rider=dynamic:player:0000000000000001"}
        ],
        "minimum_event_counts": {"horse-rider": 1},
        "maximum_event_counts": {"horse-rider": 1, "selection": 8},
        "forbidden_reason_substrings": ["bounded-repath-exhausted", "door-locked", "navmesh is not found"]
      }
    ],
    "forbidden_event_names": ["direct-teleport", "tes3-ai", "unsupported", "unresolved", "phase-loop", "route-loop"],
    "forbidden_reason_substrings": ["direct-teleport", "tes3-ai", "unsupported", "unresolved-package", "deferred-m14"],
    "maximum_repeated_events": {"tier": 16},
    "maximum_route_blocked": 500,
    "maximum_no_progress_events": 500,
    "maximum_phase_repeat": 8
  },
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {"type": "sleep", "seconds": 80},
    {"type": "focus_window", "name": "OpenMW"},
    {"type": "mouse_move", "x": 0, "y": 300},
    {"type": "sleep", "seconds": 1},
    {"type": "screenshot", "name": "horse-before-mount.png", "minimum_entropy": 0.02},
    {"type": "key", "value": "space"},
    {"type": "sleep", "seconds": 5},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 7},
    {"type": "m14_checkpoint", "name": "mounted", "minimum_actor_count": 1, "minimum_mount_count": 1,
      "required_mounted_actor": "dynamic:player:0000000000000001",
      "required_mounted_horse": "content:oblivion.esm:068451",
      "actor_state_requirements": [
        {"actor": "dynamic:player:0000000000000001", "expected": {"mount": "content:oblivion.esm:068451", "rider": "null"}},
        {"actor": "content:oblivion.esm:068451", "expected": {"mount": "null", "rider": "dynamic:player:0000000000000001"}, "forbidden_interruption_substrings": ["bounded-repath-exhausted", "door-locked"]}
      ]},
    {"type": "screenshot", "name": "horse-mounted.png", "minimum_entropy": 0.02},
    {"type": "key", "value": "space"},
    {"type": "sleep", "seconds": 4},
    {"type": "key", "value": "F5"},
    {"type": "sleep", "seconds": 7},
    {"type": "m14_checkpoint", "name": "dismounted", "minimum_actor_count": 1,
      "required_dismounted_actor": "dynamic:player:0000000000000001",
      "actor_state_requirements": [
        {"actor": "dynamic:player:0000000000000001", "expected": {"mount": "null", "rider": "null"}},
        {"actor": "content:oblivion.esm:068451", "expected": {"mount": "null", "rider": "null"}, "forbidden_interruption_substrings": ["bounded-repath-exhausted", "door-locked"]}
      ]},
    {"type": "m14_assert_events", "minimum_event_count": 100, "actor_event_requirements": [{"actor": "dynamic:player:0000000000000001", "required_event_order": [{"event": "horse-mount", "reason": "horse=content:oblivion.esm:068451"}, {"event": "horse-dismount", "reason": "horse=content:oblivion.esm:068451"}], "minimum_event_counts": {"horse-mount": 1, "horse-dismount": 1}, "maximum_event_counts": {"horse-mount": 1, "horse-dismount": 1}}, {"actor": "content:oblivion.esm:068451", "required_events": [{"event": "horse-rider", "reason": "rider=dynamic:player:0000000000000001"}], "minimum_event_counts": {"horse-rider": 1}, "maximum_event_counts": {"horse-rider": 1, "selection": 8}, "forbidden_reason_substrings": ["bounded-repath-exhausted", "door-locked", "navmesh is not found"]}], "maximum_route_blocked": 500, "maximum_no_progress_events": 500},
    {"type": "assert_file", "path_glob": "userdata/saves/*/*.omwsave", "expected_count": 1, "minimum_size": 1024, "contains_ascii": ["T4ST", "OMW4STATE"]},
    {"type": "sleep", "seconds": 2}
  ],
  "terminate_after_actions": true,
  "timeout_seconds": 150,
  "expected_exit": 0,
  "expected_log": ["Selected game profile: oblivion", "Starting a new game", "Writing saved game 'Quicksave'"],
  "forbidden_log": ["Unsupported ObScript command", "Error in frame", "onFrame failed", "Segmentation fault", "Assertion.*failed", "Aborted"],
  "reviewed_error_log": ["Failed to open image: Resource '(?:icons|textures)/[a-z0-9_./-]+\\.dds' not found", "Failed to load 'meshes/(?:ashcloud|blightcloud|blizzard|snow|xargonian_swimkna)\\.nif': Resource .* not found, using marker_error instead"]
}
