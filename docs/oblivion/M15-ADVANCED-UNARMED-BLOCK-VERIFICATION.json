  "tested_CPP_fingerprint": "0ed2a5395cae77c1f51fd62a15fe29e37fa3c28168eb516eefa52743718f9710",
  "independent_references": [
    "M15-ZERO-ABSORPTION-MASTER-DISPATCH-ORACLE-VERIFICATION.json",
