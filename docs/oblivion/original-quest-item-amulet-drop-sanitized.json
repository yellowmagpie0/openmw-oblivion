{
  "schema_version": 1,
  "name": "Actual earned Amulet cursor drop and weight",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = false\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal Actor=require('openmw.types').Actor\nlocal elapsed=0\nlocal t=0\nreturn {{engineHandlers={{onFrame=function(dt)\n print('QuestItemUiFrame')\n elapsed=elapsed+dt;t=t+dt;if t<.2 then return end;t=0\n assert(not Actor.isDead(self),'Player died during original amulet continuation')\n print('VilverinContinue amulet sample count='..Actor.inventory(self):countOf(core.getFormId('Oblivion.esm',0x250a0))..' weight='..Actor.getEncumbrance(self)..' stance='..tostring(Actor.getStance(self))..' health='..Actor.stats.dynamic.health(self).current)\n if elapsed>=4 then print('VilverinContinue amulet settled') end\nend}}}}\n"
    },
    {
      "path": "test-data/events.txt",
      "content": ""
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 1280,
  "height": 720,
