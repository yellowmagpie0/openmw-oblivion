    },
    {
      "type": "mouse_move_absolute",
      "x": 362,
      "y": 437
    },
    {
      "type": "mouse_click",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 1
    },
    {
      "type": "screenshot",
      "name": "native-ingredient-2-selected.png",
