{
  "schema_version": 1,
  "name": "Original Natural Caverns tutorial kit: one Damage Health poison",
  "cwd": "{source}",
  "files": [
    {
      "path": "config/openmw.cfg",
      "content": "replace=config\nreplace=data\nresources=\"{resources}\"\ndata=\"{oblivion_data}\"\ncontent=Oblivion.esm\nstart=ImperialDungeon01\nskip-menu=1\nnew-game=0\nno-grab=1\nuser-data=\"{output}/userdata\"\ndata-local=\"{output}/test-data\"\ncontent=tutorial-passage-observer.omwscripts\n"
    },
    {
      "path": "config/settings.cfg",
      "content": "[Video]\nresolution x = 1280\nresolution y = 720\nfullscreen = false\nframerate limit = 60\n[General]\nscreenshot format = png\n\n[Input]\nenable controller = true\n\n[GUI]\ncontroller menus = false\n\n[Input]\ncamera sensitivity = 0.5\n"
    },
    {
      "path": "test-data/events.txt",
      "content": "at 0 command dynamic:player:0000000000000001 GetAV Health\n"
    },
    {
      "path": "test-data/tutorial-passage-observer.omwscripts",
      "content": "PLAYER: scripts/tutorial_passage_observer.lua\n"
    },
    {
      "path": "test-data/scripts/tutorial_passage_observer.lua",
      "content": "local self=require('openmw.self')\nlocal core=require('openmw.core')\nlocal types=require('openmw.types')\nlocal Actor=types.Actor\nlocal I=require('openmw.interfaces')\nlocal frames=0\nreturn {{engineHandlers={{onFrame=function()\n frames=frames+1;if frames%15~=0 then return end\n assert(not Actor.isDead(self),'Player died at tutorial alchemy UI')\n local inv=Actor.inventory(self)\n print('AlchemyUI stock='..inv:countOf(core.getFormId('Oblivion.esm',0xc7968))..'/'..inv:countOf(core.getFormId('Oblivion.esm',0x6251f))..'/'..inv:countOf(core.getFormId('Oblivion.esm',0x8446d))..' paused='..tostring(core.isWorldPaused())..' mode='..tostring(I.UI.getMode())..' controls='..tostring(types.Player.getControlSwitch(self,types.Player.CONTROL_SWITCH.Controls)))\n for _,o in ipairs(inv:getAll()) do if types.Potion.objectIsInstance(o) then local r=types.Potion.record(o);if r.name=='Damage Health' then print('AlchemyUI poison count='..o.count..' weight='..r.weight..' value='..r.value..' id='..o.recordId) end end end\nend}}}}\n"
    }
  ],
  "command": [
    "{openmw}",
    "--replace=config",
    "--config",
    "{output}/config",
    "--no-sound=1",
    "--no-grab",
    "--load-savegame={input_save}"
  ],
  "xvfb": true,
  "width": 1280,
  "height": 720,
  "actions": [
    {
      "type": "wait_log",
      "path": "events.jsonl",
      "pattern": "\"event\"\\s*:\\s*\"load-complete\"",
      "timeout_seconds": 600,
      "abort_on_failure": true
    },
    {
      "type": "wait_log",
      "pattern": "AlchemyUI stock=1/1/1",
      "timeout_seconds": 120,
      "abort_on_failure": true
    },
    {
      "type": "focus_window",
      "name": "OpenMW"
    },
    {
      "type": "key_hold",
      "value": "Tab",
      "seconds": 0.3
    },
    {
      "type": "sleep",
      "seconds": 2
    },
    {
      "type": "mouse_move_absolute",
      "x": 282,
      "y": 520
    },
    {
      "type": "mouse_click",
      "button": 1
    },
    {
      "type": "sleep",
      "seconds": 0.4
    },
    {
      "type": "mouse_move_absolute",
      "x": 80,
